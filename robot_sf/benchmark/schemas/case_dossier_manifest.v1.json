            "right": {"$ref": "#/$defs/closestApproachStatus"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "closestApproachStatus": {
      "oneOf": [
        {"$ref": "#/$defs/closestApproachAvailable"},
        {"$ref": "#/$defs/closestApproachUnavailable"}
      ]
    },
    "closestApproachAvailable": {
      "type": "object",
