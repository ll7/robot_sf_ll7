{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/visualization_spec.v1.json",
  "$title": "Robot SF Visualization Spec v1",
  "description": "Renderer-neutral visualization specification. Source simulation time and presentation time stay separate; half-open source intervals with explicit terminal-frame inclusion prevent duplicate cut-boundary frames.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "sources"],
  "properties": {
    "schema_version": {"const": "visualization-spec.v1"},
    "spec_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1}}
      }
    },
    "actor_selection": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "event_selection": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "camera": {"type": "object", "additionalProperties": true},
    "layout": {"type": "object", "additionalProperties": true},
    "layers": {"type": "array", "items": {"type": "string"}},
    "style": {"type": "object", "additionalProperties": true},
    "annotations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "comparisons": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "source_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_s", "end_s"],
        "properties": {
          "start_s": {"type": "number"},
          "end_s": {"type": "number"},
          "include_terminal_frame": {"type": "boolean"}
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "speed": {"type": "number", "exclusiveMinimum": 0},
        "cuts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "pauses": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "presentation_timestamp_map": {"type": "object", "additionalProperties": true}
      }
    },
    "units": {
      "type": "string",
      "description": "Seconds/metres/radians unless a source-declared transform converts them."
    },
    "unit_transforms": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  }
}
