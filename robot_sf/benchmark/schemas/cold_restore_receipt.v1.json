{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.dev/schemas/cold_restore_receipt.v1.json",
  "title": "Robot SF cold-restore receipt (v1)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "claim_boundary", "capsule", "environment", "cache", "destination", "restored", "validation", "timing", "unavailable_dependencies", "result", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "cold_restore_receipt.v1"}, "mode": {"enum": ["synthetic", "real"]}, "claim_boundary": {"type": "string", "minLength": 1}, "capsule": {"$ref": "#/$defs/capsule"}, "environment": {"type": "object", "additionalProperties": false, "required": ["requirement", "observed"], "properties": {"requirement": {"type": ["object", "null"]}, "observed": {"type": ["object", "null"]}}}, "cache": {"type": "object", "additionalProperties": false, "required": ["status", "ambient_reads", "variables"], "properties": {"status": {"const": "isolated"}, "ambient_reads": {"const": 0}, "variables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}, "destination": {"type": "object", "additionalProperties": false, "required": ["kind", "identity", "marker"], "properties": {"kind": {"const": "task_owned_temporary_root"}, "identity": {"$ref": "#/$defs/nullable_sha256"}, "marker": {"const": ".cold_restore_owner.json"}}}, "restored": {"$ref": "#/$defs/restored"}, "validation": {"type": "object", "additionalProperties": true, "required": ["status", "commands"], "properties": {"status": {"enum": ["not_run", "verified", "failed"]}, "commands": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}, "timing": {"type": "object", "additionalProperties": false, "required": ["elapsed_seconds", "normalization"], "properties": {"elapsed_seconds": {"type": "number", "minimum": 0}, "normalization": {"type": "string", "minLength": 1}}}, "unavailable_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "result": {"$ref": "#/$defs/result"}, "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "capsule": {"type": "object", "additionalProperties": false, "required": ["id", "artifact_version", "artifact_digest", "capsule_digest", "source_commit", "config_id", "config_sha256", "seed", "checkpoint_id"], "properties": {"id": {"type": ["string", "null"]}, "artifact_version": {"type": ["string", "null"]}, "artifact_digest": {"$ref": "#/$defs/nullable_sha256"}, "capsule_digest": {"$ref": "#/$defs/nullable_sha256"}, "source_commit": {"type": ["string", "null"]}, "config_id": {"type": ["string", "null"]}, "config_sha256": {"$ref": "#/$defs/nullable_sha256"}, "seed": {"type": ["integer", "null"]}, "checkpoint_id": {"type": ["string", "null"]}}}, "member": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "content_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}, "content_sha256": {"$ref": "#/$defs/sha256"}}}, "restored": {"type": "object", "additionalProperties": false, "required": ["status", "members", "member_count", "byte_count", "transferred_bytes", "artifact_manifest_id", "tree_sha256"], "properties": {"status": {"enum": ["not_started", "partial", "verified"]}, "members": {"type": "array", "items": {"$ref": "#/$defs/member"}}, "member_count": {"type": "integer", "minimum": 0}, "byte_count": {"type": "integer", "minimum": 0}, "transferred_bytes": {"type": "integer", "minimum": 0}, "artifact_manifest_id": {"$ref": "#/$defs/nullable_sha256"}, "tree_sha256": {"$ref": "#/$defs/nullable_sha256"}}}, "result": {"type": "object", "additionalProperties": false, "required": ["status", "failure"], "properties": {"status": {"enum": ["verified", "failed", "unavailable"]}, "failure": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["code", "member"], "properties": {"code": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "member": {"type": ["string", "null"]}}}]}}}
  }
}
