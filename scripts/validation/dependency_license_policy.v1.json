  "rules": [
    {
      "id": "user-installed-requires-disposition",
      "distribution_mode": "user_installed",
      "disposition": "review_required",
      "rationale": "A user-installed dependency is not automatically redistributed by Robot SF, but unknown, proprietary, or conflicting metadata remains visible and requires an explicit release-surface decision."
    },
    {
      "id": "bundled-source-requires-disposition",
      "distribution_mode": "bundled_source",
      "disposition": "review_required",
      "rationale": "Source or package content carried by a Robot SF artifact requires a reviewed non-blocked disposition and matching notices/provenance."
    },
    {
      "id": "built-companion-requires-disposition",
      "distribution_mode": "built_companion",
      "disposition": "review_required",
      "rationale": "A built companion is a release surface and requires an explicit reviewed disposition, source identity, and license/notice proof."
    },
    {
      "id": "not-distributed-excluded",
      "distribution_mode": "not_distributed",
      "disposition": "excluded",
      "rationale": "Content explicitly excluded from the named release surface is not a redistribution claim; the exclusion must remain enforced by packaging checks."
    }
  ],
