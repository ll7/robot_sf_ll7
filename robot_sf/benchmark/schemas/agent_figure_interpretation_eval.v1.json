{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/robot-sf/agent_figure_interpretation_eval.v1.json",
  "title": "Agent Figure Interpretation Evaluation Result (v1)",
  "description": "Deterministic fixture replay result for evaluating agent interpretation of frozen figure packets. These are evaluation artifacts only, not benchmark evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claim_boundary",
    "case_count",
    "critical_error_counts",
    "aggregate_summary",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_figure_interpretation_eval.v1"
    },
    "status": {
      "const": "evaluation_artifacts_only"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "critical_error_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unavailable_to_zero",
        "denominator_loss",
        "wrong_pairing_resampling",
        "fallback_degraded_promotion",
        "causal_overclaim",
        "unsupported_ranking",
        "null_overclaim",
        "effect_direction_desirability",
        "native_adapter_merge",
        "multiplicity_language"
      ],
      "properties": {
        "unavailable_to_zero": {"type": "integer", "minimum": 0},
        "denominator_loss": {"type": "integer", "minimum": 0},
        "wrong_pairing_resampling": {"type": "integer", "minimum": 0},
        "fallback_degraded_promotion": {"type": "integer", "minimum": 0},
        "causal_overclaim": {"type": "integer", "minimum": 0},
        "unsupported_ranking": {"type": "integer", "minimum": 0},
        "null_overclaim": {"type": "integer", "minimum": 0},
        "effect_direction_desirability": {"type": "integer", "minimum": 0},
        "native_adapter_merge": {"type": "integer", "minimum": 0},
        "multiplicity_language": {"type": "integer", "minimum": 0}
      }
    },
    "aggregate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_status_counts",
        "dimension_scores",
        "critical_error_counts",
        "critical_failure_examples",
        "reviewer_accounting",
        "workflow_variants"
      ],
      "properties": {
        "case_status_counts": {"$ref": "#/$defs/case_status_counts"},
        "dimension_scores": {"$ref": "#/$defs/dimension_scores"},
        "critical_error_counts": {"$ref": "#/$defs/critical_error_counts"},
        "critical_failure_examples": {"$ref": "#/$defs/critical_failure_examples"},
        "reviewer_accounting": {"$ref": "#/$defs/reviewer_summary"},
        "workflow_variants": {"$ref": "#/$defs/workflow_variants"}
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packet_id",
          "artifact_kind",
          "status",
          "scores",
          "critical_errors",
          "aggregate_score",
          "claim_boundary"
        ],
        "properties": {
          "packet_id": {"type": "string", "minLength": 1},
          "artifact_kind": {"const": "evaluation_artifact"},
          "status": {"enum": ["clean", "failed"]},
          "scores": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "source_denominator"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "estimand_unit"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "stats_multiplicity"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "visual_semantics"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "caption_accuracy"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "evidence_tier_availability"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "claim_boundary"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"dimension": {"const": "correction_usefulness"}},
                  "required": ["dimension"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "score", "passed", "expected", "observed"],
              "properties": {
                "dimension": {
                  "enum": [
                    "source_denominator",
                    "estimand_unit",
                    "stats_multiplicity",
                    "visual_semantics",
                    "caption_accuracy",
                    "evidence_tier_availability",
                    "claim_boundary",
                    "correction_usefulness"
                  ]
                },
                "score": {"type": "number", "minimum": 0, "maximum": 1},
                "passed": {"type": "boolean"},
                "expected": {},
                "observed": {}
              }
            }
          },
          "critical_errors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unavailable_to_zero",
              "denominator_loss",
              "wrong_pairing_resampling",
              "fallback_degraded_promotion",
              "causal_overclaim",
              "unsupported_ranking",
              "null_overclaim",
              "effect_direction_desirability",
              "native_adapter_merge",
              "multiplicity_language"
            ],
            "properties": {
              "unavailable_to_zero": {"type": "boolean"},
              "denominator_loss": {"type": "boolean"},
              "wrong_pairing_resampling": {"type": "boolean"},
              "fallback_degraded_promotion": {"type": "boolean"},
              "causal_overclaim": {"type": "boolean"},
              "unsupported_ranking": {"type": "boolean"},
              "null_overclaim": {"type": "boolean"},
              "effect_direction_desirability": {"type": "boolean"},
              "native_adapter_merge": {"type": "boolean"},
              "multiplicity_language": {"type": "boolean"}
            }
          },
          "aggregate_score": {"type": "number", "minimum": 0, "maximum": 1},
          "claim_boundary": {"type": "string", "minLength": 1},
          "interpretation_variant_comparison": {
            "type": "object",
            "additionalProperties": false,
            "required": ["baseline", "packet_constrained", "delta"],
            "properties": {
              "baseline": {"$ref": "#/$defs/variant_summary"},
              "packet_constrained": {"$ref": "#/$defs/variant_summary"},
              "delta": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "aggregate_score",
                  "critical_error_count",
                  "packet_constrained_reduces_critical_errors",
                  "packet_constrained_preserves_source_fidelity"
                ],
                "properties": {
                  "aggregate_score": {"type": "number", "minimum": -1, "maximum": 1},
                  "critical_error_count": {"type": "integer"},
                  "packet_constrained_reduces_critical_errors": {"type": "boolean"},
                  "packet_constrained_preserves_source_fidelity": {"type": "boolean"}
                }
              }
            }
          },
          "reviewer_accounting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewed",
              "blinded",
              "reviewer_count",
              "dimension_count",
              "agreed_dimensions",
              "disagreement_count",
              "agreement_rate",
              "disagreements",
              "adjudicated_dimensions",
              "adjudication_complete"
            ],
            "properties": {
              "reviewed": {"const": true},
              "blinded": {"const": true},
              "reviewer_count": {"type": "integer", "minimum": 2},
              "dimension_count": {"type": "integer", "minimum": 8},
              "agreed_dimensions": {"type": "integer", "minimum": 0},
              "disagreement_count": {"type": "integer", "minimum": 0},
              "agreement_rate": {"type": "number", "minimum": 0, "maximum": 1},
              "disagreements": {"type": "object"},
              "adjudicated_dimensions": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "adjudication_complete": {"type": "boolean"}
            }
          },
          "correction_priority_ranking": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rank",
                "id",
                "dimension",
                "severity",
                "triggered_by_critical_error",
                "dimension_failed"
              ],
              "properties": {
                "rank": {"type": "integer", "minimum": 1},
                "id": {"type": "string", "minLength": 1},
                "dimension": {"type": "string", "minLength": 1},
                "severity": {"enum": ["critical", "major", "minor"]},
                "triggered_by_critical_error": {"type": "boolean"},
                "dimension_failed": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "critical_error_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unavailable_to_zero",
        "denominator_loss",
        "wrong_pairing_resampling",
        "fallback_degraded_promotion",
        "causal_overclaim",
        "unsupported_ranking",
        "null_overclaim"
      ],
      "properties": {
        "unavailable_to_zero": {"type": "integer", "minimum": 0},
        "denominator_loss": {"type": "integer", "minimum": 0},
        "wrong_pairing_resampling": {"type": "integer", "minimum": 0},
        "fallback_degraded_promotion": {"type": "integer", "minimum": 0},
        "causal_overclaim": {"type": "integer", "minimum": 0},
        "unsupported_ranking": {"type": "integer", "minimum": 0},
        "null_overclaim": {"type": "integer", "minimum": 0},
        "effect_direction_desirability": {"type": "integer", "minimum": 0},
        "native_adapter_merge": {"type": "integer", "minimum": 0},
        "multiplicity_language": {"type": "integer", "minimum": 0}
      }
    },
    "case_status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "failed"],
      "properties": {
        "clean": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "dimension_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "passed_count", "failed_count", "pass_rate"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 0},
        "passed_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "pass_rate": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_denominator",
        "estimand_unit",
        "stats_multiplicity",
        "visual_semantics",
        "caption_accuracy",
        "evidence_tier_availability",
        "claim_boundary",
        "correction_usefulness"
      ],
      "properties": {
        "source_denominator": {"$ref": "#/$defs/dimension_summary"},
        "estimand_unit": {"$ref": "#/$defs/dimension_summary"},
        "stats_multiplicity": {"$ref": "#/$defs/dimension_summary"},
        "visual_semantics": {"$ref": "#/$defs/dimension_summary"},
        "caption_accuracy": {"$ref": "#/$defs/dimension_summary"},
        "evidence_tier_availability": {"$ref": "#/$defs/dimension_summary"},
        "claim_boundary": {"$ref": "#/$defs/dimension_summary"},
        "correction_usefulness": {"$ref": "#/$defs/dimension_summary"}
      }
    },
    "critical_failure_examples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unavailable_to_zero",
        "denominator_loss",
        "wrong_pairing_resampling",
        "fallback_degraded_promotion",
        "causal_overclaim",
        "unsupported_ranking",
        "null_overclaim",
        "effect_direction_desirability",
        "native_adapter_merge",
        "multiplicity_language"
      ],
      "properties": {
        "unavailable_to_zero": {"$ref": "#/$defs/packet_id_list"},
        "denominator_loss": {"$ref": "#/$defs/packet_id_list"},
        "wrong_pairing_resampling": {"$ref": "#/$defs/packet_id_list"},
        "fallback_degraded_promotion": {"$ref": "#/$defs/packet_id_list"},
        "causal_overclaim": {"$ref": "#/$defs/packet_id_list"},
        "unsupported_ranking": {"$ref": "#/$defs/packet_id_list"},
        "null_overclaim": {"$ref": "#/$defs/packet_id_list"},
        "effect_direction_desirability": {"$ref": "#/$defs/packet_id_list"},
        "native_adapter_merge": {"$ref": "#/$defs/packet_id_list"},
        "multiplicity_language": {"$ref": "#/$defs/packet_id_list"}
      }
    },
    "packet_id_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reviewer_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_case_count",
        "adjudication_complete_case_count",
        "disagreement_count",
        "mean_agreement_rate"
      ],
      "properties": {
        "status": {"enum": ["not_available", "partial", "available"]},
        "reviewed_case_count": {"type": "integer", "minimum": 0},
        "adjudication_complete_case_count": {"type": "integer", "minimum": 0},
        "disagreement_count": {"type": "integer", "minimum": 0},
        "mean_agreement_rate": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "workflow_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "paired_case_count",
        "baseline_case_count",
        "packet_constrained_case_count",
        "mean_aggregate_score_delta",
        "critical_error_count_delta",
        "packet_constrained_reduces_critical_errors",
        "packet_constrained_preserves_source_fidelity"
      ],
      "properties": {
        "status": {"enum": ["not_available", "partial", "available"]},
        "paired_case_count": {"type": "integer", "minimum": 0},
        "baseline_case_count": {"type": "integer", "minimum": 0},
        "packet_constrained_case_count": {"type": "integer", "minimum": 0},
        "mean_aggregate_score_delta": {
          "anyOf": [
            {"type": "number", "minimum": -1, "maximum": 1},
            {"type": "null"}
          ]
        },
        "critical_error_count_delta": {
          "anyOf": [{"type": "integer"}, {"type": "null"}]
        },
        "packet_constrained_reduces_critical_errors": {
          "anyOf": [{"type": "boolean"}, {"type": "null"}]
        },
        "packet_constrained_preserves_source_fidelity": {
          "anyOf": [{"type": "boolean"}, {"type": "null"}]
        }
      }
    },
    "variant_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_score",
        "critical_error_count",
        "dimension_failures",
        "critical_errors"
      ],
      "properties": {
        "aggregate_score": {"type": "number", "minimum": 0, "maximum": 1},
        "critical_error_count": {"type": "integer", "minimum": 0},
        "dimension_failures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "critical_errors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unavailable_to_zero",
            "denominator_loss",
            "wrong_pairing_resampling",
            "fallback_degraded_promotion",
            "causal_overclaim",
            "unsupported_ranking",
            "null_overclaim",
            "effect_direction_desirability",
            "native_adapter_merge",
            "multiplicity_language"
          ],
          "properties": {
            "unavailable_to_zero": {"type": "boolean"},
            "denominator_loss": {"type": "boolean"},
            "wrong_pairing_resampling": {"type": "boolean"},
            "fallback_degraded_promotion": {"type": "boolean"},
            "causal_overclaim": {"type": "boolean"},
            "unsupported_ranking": {"type": "boolean"},
            "null_overclaim": {"type": "boolean"},
            "effect_direction_desirability": {"type": "boolean"},
            "native_adapter_merge": {"type": "boolean"},
            "multiplicity_language": {"type": "boolean"}
          }
        }
      }
    }
  }
}
