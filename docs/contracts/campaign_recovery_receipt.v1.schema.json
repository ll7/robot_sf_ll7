{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ll7.github.io/robot_sf_ll7/schemas/campaign_recovery_receipt.v1.schema.json",
  "title": "Campaign recovery receipt v1",
  "description": "Deterministic receipt verifying campaign resume, retry behavior, and lineage preservation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "runner_class",
    "status",
    "verdict",
    "retry_admitted",
    "authority_inputs_matched",
    "completed_rows_preserved",
    "reconciled_to_expected_ledger",
    "expected_row_count",
    "reconciled_row_count",
    "discrepancies",
    "attempts",
    "recomputed_at_utc"
  ],
  "properties": {
    "schema": { "const": "campaign_recovery_receipt.v1" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "runner_class": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail", "unsupported"] },
    "verdict": { "enum": ["pass", "fail"] },
    "interruption_reason": { "type": ["string", "null"] },
    "interruption_class": { "type": ["string", "null"], "enum": ["infrastructure", "outcome", "unknown", null] },
    "retry_admitted": { "type": "boolean" },
    "authority_inputs_matched": { "type": "boolean" },
    "completed_rows_preserved": { "type": "boolean" },
    "reconciled_to_expected_ledger": { "type": "boolean" },
    "expected_row_count": { "type": "integer", "minimum": 0 },
    "reconciled_row_count": { "type": "integer", "minimum": 0 },
    "discrepancies": { "type": "array", "items": { "type": "string" } },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_index", "job_id", "status"],
        "properties": {
          "attempt_index": { "type": "integer", "minimum": 0 },
          "job_id": { "type": "string" },
          "row_count": { "type": "integer", "minimum": 0 },
          "status": { "type": "string" },
          "metadata": { "type": ["object", "null"] }
        }
      }
    },
    "recomputed_at_utc": { "type": "string" }
  }
}
