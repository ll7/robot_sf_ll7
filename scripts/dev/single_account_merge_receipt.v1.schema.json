{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ll7/robot_sf_ll7/schemas/single_account_merge_receipt.v1.schema.json",
  "title": "Robot SF bounded single-account merge receipt",
  "type": "object",
  "required": [
    "schema",
    "repository",
    "pr_number",
    "head_sha",
    "base_sha",
    "current_base_sha",
    "metadata_digest",
    "required_checks",
    "implementation_review",
    "thread_resolution",
    "requested_reviewers",
    "requested_teams",
    "holds",
    "waiver",
    "expected_head_cas",
    "observed_at",
    "merge_result",
    "receipt_digest",
    "status",
    "reason_codes"
  ],
  "properties": {
    "schema": {"const": "single_account_merge_receipt.v1"},
    "repository": {"type": "string", "minLength": 3},
    "pr_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "current_base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "metadata_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "pr_state": {
      "type": ["string", "null"],
      "enum": ["OPEN", "CLOSED", "MERGED", null]
    },
    "pr_merged_at": {"type": ["string", "null"]},
    "required_checks": {
      "type": "object",
      "required": ["status", "head_sha", "checks", "reason_codes"],
      "properties": {
        "status": {
          "enum": ["success", "failure", "pending", "unavailable", "stale", "malformed"]
        },
        "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "checks": {"type": "array"},
        "reason_codes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementation_review": {
      "type": "object",
      "required": ["status", "carrier", "reason_codes"],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "missing",
            "pending",
            "unavailable",
            "stale",
            "conflicting",
            "malformed",
            "superseded",
            "dismissed",
            "withdrawn",
            "failure"
          ]
        },
        "carrier": {"type": ["object", "null"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "thread_resolution": {"type": "object"},
    "requested_reviewers": {"type": "object"},
    "requested_teams": {"type": "object"},
    "holds": {
      "type": "object",
      "required": [
        "merge",
        "dependency",
        "draft",
        "domain",
        "scientific_evidence",
        "legal_release",
        "security"
      ],
      "properties": {
        "merge": {"$ref": "#/$defs/disposition"},
        "dependency": {"$ref": "#/$defs/disposition"},
        "draft": {"$ref": "#/$defs/disposition"},
        "domain": {"$ref": "#/$defs/disposition"},
        "scientific_evidence": {"$ref": "#/$defs/disposition"},
        "legal_release": {"$ref": "#/$defs/disposition"},
        "security": {"$ref": "#/$defs/disposition"}
      }
    },
    "waiver": {
      "type": "object",
      "required": ["used", "actor", "reason", "observed_at"],
      "properties": {
        "used": {"type": "boolean"},
        "actor": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]},
        "observed_at": {"type": "string", "minLength": 1}
      }
    },
    "expected_head_cas": {
      "type": "object",
      "required": ["request", "status"],
      "properties": {
        "request": {"type": "object"},
        "status": {"type": "string"}
      }
    },
    "ordinary_cas": {
      "type": ["object", "null"],
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"enum": ["accepted", "blocked", "not_required"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "selector": {
          "type": "object",
          "required": [
            "status",
            "selector",
            "candidate_files",
            "changed_file_records",
            "changed_files",
            "changed_sensitive_files",
            "complete",
            "content_provenance",
            "current_main_sha",
            "current_main_ref_verified",
            "head_sha",
            "base_sha"
          ],
          "properties": {
            "status": {"enum": ["ordinary", "base_sensitive", "unknown"]},
            "selector": {"const": "pytest-marker-files.v2"},
            "candidate_files": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "changed_file_records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["filename", "previous_filename", "status"],
                "properties": {
                  "filename": {"type": "string", "minLength": 1},
                  "previous_filename": {"type": ["string", "null"]},
                  "status": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "changed_files": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "changed_sensitive_files": {"type": "array", "items": {"type": "string"}},
            "complete": {"type": "boolean"},
            "content_provenance": {"type": "array", "items": {"type": "object"}},
            "current_main_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "current_main_ref_verified": {"const": true},
            "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
          }
        },
        "base_policy": {
          "type": "object",
          "required": ["status", "policy", "head_sha", "carrier"],
          "properties": {
            "status": {"enum": ["accepted", "missing"]},
            "policy": {"const": "ordinary-cas"},
            "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "carrier": {"type": ["string", "null"]}
          }
        },
        "current_base_cas": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["accepted", "blocked"]}},
            "required": ["status"]
          },
          "then": {"required": ["selector", "base_policy", "current_base_cas"]}
        }
      ]
    },
    "gate_audit": {"type": ["object", "null"]},
    "evidence_provenance": {
      "type": "object",
      "required": ["schema", "data_source", "ordinary_facts", "review_threads"],
      "properties": {
        "schema": {"const": "single_account_merge_evidence_provenance.v1"},
        "data_source": {
          "enum": [
            "graphql",
            "rest_fallback_graphql_quota"
          ]
        },
        "ordinary_facts": {
          "type": "object",
          "required": [
            "pull_request",
            "labels",
            "comments",
            "reviews",
            "requested_reviewers",
            "check_rollup",
            "base_sha",
            "changed_coverage"
          ],
          "properties": {
            "pull_request": {"enum": ["graphql", "rest"]},
            "labels": {"enum": ["graphql", "rest"]},
            "comments": {"enum": ["graphql", "rest"]},
            "reviews": {"enum": ["graphql", "rest"]},
            "requested_reviewers": {"enum": ["graphql", "rest"]},
            "check_rollup": {"enum": ["graphql", "rest"]},
            "base_sha": {"const": "rest"},
            "changed_coverage": {"const": "rest"}
          }
        },
        "review_threads": {
          "type": "object",
          "required": ["source", "status"],
          "properties": {
            "source": {"const": "graphql"},
            "status": {
              "enum": ["separate_query", "resolved", "unresolved", "unavailable"]
            },
            "diagnostic": {"type": "string"}
          }
        },
        "fallback_diagnostic": {"type": ["string", "null"]}
      }
    },
    "observed_at": {"type": "string", "minLength": 1},
    "merge_result": {
      "type": "object",
      "required": ["status", "returned_merged_sha"],
      "properties": {
        "status": {"enum": ["not_applied", "failed", "merged"]},
        "returned_merged_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "status": {"enum": ["ready", "blocked", "applied", "merged"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "$defs": {
    "disposition": {
      "type": "object",
      "required": ["status", "reason_codes", "source"],
      "properties": {
        "status": {"type": "string"},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"}
      }
    }
  }
}
