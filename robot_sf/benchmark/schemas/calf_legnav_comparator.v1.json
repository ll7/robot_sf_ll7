{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/calf_legnav_comparator.v1.json",
  "title": "CALF/LegNav-inspired Robot SF comparator diagnostic v1",
  "description": "Paired ideal/perception-limited Robot SF policy smoke with explicit transfer limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "status",
    "evidence_status",
    "claim_boundary",
    "method_card",
    "provenance",
    "conditions",
    "paired_metrics",
    "unsupported_fields",
    "zero_shot_transfer",
    "comparison_interpretation"
  ],
  "properties": {
    "schema_version": {"const": "calf_legnav_comparator.v1"},
    "issue": {"const": 7318},
    "status": {"enum": ["available", "blocked"]},
    "evidence_status": {"const": "diagnostic-only"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "method_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_title", "source_url", "source_method", "local_transfer_question"],
      "properties": {
        "source_title": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "source_method": {"type": "object", "additionalProperties": {"type": "string"}},
        "local_transfer_question": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "algo",
        "scenario_id",
        "seed",
        "horizon",
        "config_digest",
        "input_refs",
        "paired_episode_count",
        "uncertainty"
      ],
      "properties": {
        "candidate": {"type": "string", "minLength": 1},
        "algo": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "horizon": {"type": "integer", "minimum": 1},
        "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_refs": {"type": "object", "additionalProperties": {"type": "string"}},
        "paired_episode_count": {"const": 1},
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unavailable"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perfect_perception", "sensor_limited"],
      "properties": {
        "perfect_perception": {"$ref": "#/$defs/condition"},
        "sensor_limited": {"$ref": "#/$defs/condition"}
      }
    },
    "paired_metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/pairedMetric"}
    },
    "unsupported_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "status", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "status": {"const": "unavailable"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "zero_shot_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "unavailable"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "comparison_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result", "not_claims"],
      "properties": {
        "status": {"const": "diagnostic-only"},
        "result": {"const": "paired_observation_contract_smoke"},
        "not_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "runner_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "status", "reason", "command"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "status": {"const": "blocked"},
          "reason": {"type": "string", "minLength": 1},
          "stderr_excerpt": {"type": "string"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": true,
      "required": ["value", "status", "units", "source", "mapping_class"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "status": {"enum": ["available", "unavailable", "blocked"]},
        "units": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "mapping_class": {"enum": ["exact_local", "qualified_proxy"]},
        "reason": {"type": "string"}
      }
    },
    "pairedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perfect_perception", "sensor_limited", "sensor_minus_perfect", "delta_status"],
      "properties": {
        "perfect_perception": {"$ref": "#/$defs/metric"},
        "sensor_limited": {"$ref": "#/$defs/metric"},
        "sensor_minus_perfect": {"type": ["number", "null"]},
        "delta_status": {"enum": ["available", "unavailable"]}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scenario_id", "seed", "candidate", "algo", "observation_contract", "execution", "metrics"],
      "properties": {
        "status": {"enum": ["available", "blocked"]},
        "scenario_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "candidate": {"type": "string", "minLength": 1},
        "algo": {"type": "string", "minLength": 1},
        "observation_contract": {
          "type": "object",
          "additionalProperties": true,
          "required": ["condition", "status", "evidence_classes", "noise_profiles", "config", "observed_actor_count"],
          "properties": {
            "condition": {"type": "string"},
            "status": {"enum": ["available", "unavailable"]},
            "evidence_classes": {"type": "array", "items": {"type": "string"}},
            "noise_profiles": {"type": "array", "items": {"type": "string"}},
            "config": {"type": "object"},
            "observed_actor_count": {"type": "object"}
          }
        },
        "execution": {"type": "object", "additionalProperties": true},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}}
      }
    }
  }
}
