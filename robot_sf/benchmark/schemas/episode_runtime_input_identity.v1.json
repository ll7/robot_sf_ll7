{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/robot-sf/episode_runtime_input_identity.v1.json",
  "title": "RobotSF Episode Runtime Input Identity Extension (v1)",
  "type": "object",
  "required": [
    "runtime_input_records",
    "selected_map_identity"
  ],
  "properties": {
    "runtime_input_records": {
      "type": "array",
      "description": "Producer-captured map and route file identities consumed while building this episode environment.",
      "items": {
        "type": "object",
        "required": [
          "role",
          "scenario_id",
          "sha256",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "map_id": {
            "type": "string",
            "minLength": 1
          },
          "parser": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "selected_map_identity": {
      "type": "object",
      "description": "Producer-captured identity of the map actually selected by the episode environment.",
      "required": [
        "schema_version",
        "status",
        "map_id",
        "path",
        "sha256",
        "source_role",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "selected_map_identity.v1"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "map_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "map_file",
            "default_map_pool",
            null
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "map_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_role": {
                "enum": [
                  "map_file",
                  "default_map_pool"
                ]
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "path": {
                "type": "null"
              },
              "sha256": {
                "type": "null"
              },
              "source_role": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
