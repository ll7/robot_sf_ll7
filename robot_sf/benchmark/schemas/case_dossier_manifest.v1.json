        "time_to_closest_approach_s",
        "proxy_surface_clearance_at_closest_approach_m",
        "model",
        "profile_version"
      ],
      "properties": {
        "status": {"const": "available"},
        "reason": {"const": "valid_local_closest_approach_diagnostic"},
        "source_time_s": {"type": "number"},
        "time_to_closest_approach_s": {"type": "number"},
        "proxy_surface_clearance_at_closest_approach_m": {"type": "number"},
