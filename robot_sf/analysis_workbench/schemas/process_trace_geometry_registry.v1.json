{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/process_trace_geometry_registry.v1.json",
  "title": "Robot SF Process Trace Geometry Registry v1",
  "description": "Analysis-workbench adapter and receipt format for hash-bound route and conflict-zone geometry used by worked-example process traces; production entries bind upstream map, scenario, or evidence owners rather than replacing them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "artifact_ref", "coordinate_frame", "routes", "conflict_zones"],
  "properties": {
    "schema_version": {"const": "process_trace_geometry_registry.v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Stable repo-relative reference or logical URI; never an absolute machine-local path."
    },
    "coordinate_frame": {"const": "world"},
    "routes": {
      "type": "array",
      "items": {"$ref": "#/$defs/route_entry"}
    },
    "conflict_zones": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict_zone_entry"}
    }
  },
  "$defs": {
    "vector2": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    },
    "line_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "end"],
      "properties": {
        "type": {"const": "line_segment"},
        "start": {"$ref": "#/$defs/vector2"},
        "end": {"$ref": "#/$defs/vector2"}
      }
    },
    "polyline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "points"],
      "properties": {
        "type": {"const": "polyline"},
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/vector2"}
        }
      }
    },
    "route_graph": {
      "type": "object",
      "description": "Recognized as authored input but deliberately unavailable for process-trace projection because branch selection is ambiguous.",
      "additionalProperties": false,
      "required": ["type", "segments"],
      "properties": {
        "type": {"const": "route_graph"},
        "segments": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/line_segment"}
        }
      }
    },
    "circle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "center", "radius_m"],
      "properties": {
        "type": {"const": "circle"},
        "center": {"$ref": "#/$defs/vector2"},
        "radius_m": {"type": "number", "minimum": 0}
      }
    },
    "point": {
      "type": "object",
      "description": "Recognized owner geometry that is deliberately unavailable until a point-zone projection contract exists.",
      "additionalProperties": false,
      "required": ["type", "position"],
      "properties": {
        "type": {"const": "point"},
        "position": {"$ref": "#/$defs/vector2"}
      }
    },
    "polygon": {
      "type": "object",
      "description": "Recognized owner geometry that is deliberately unavailable until a polygon-zone projection contract exists.",
      "additionalProperties": false,
      "required": ["type", "points"],
      "properties": {
        "type": {"const": "polygon"},
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/vector2"}
        }
      }
    },
    "fixture_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fixture_id"],
      "properties": {
        "kind": {"const": "fixture_only"},
        "fixture_id": {"type": "string", "minLength": 1}
      }
    },
    "canonical_source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_artifact_ref", "source_content_sha256", "selector"],
      "properties": {
        "kind": {"const": "canonical_source"},
        "source_artifact_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Stable repo-relative reference or non-file logical URI; absolute, file URI, backslash, tilde, dot, and parent traversal forms are invalid."
        },
        "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "number", "boolean"]},
          "description": "Owner-native selector such as map_id, spawn_id, goal_id, SVG route ID, scenario ID, or zone ID."
        }
      }
    },
    "upstream_binding": {
      "oneOf": [
        {"$ref": "#/$defs/fixture_binding"},
        {"$ref": "#/$defs/canonical_source_binding"}
      ]
    },
    "route_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "route_id", "upstream_binding", "geometry"],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "route_id": {"type": "string", "minLength": 1},
        "upstream_binding": {"$ref": "#/$defs/upstream_binding"},
        "geometry": {
          "oneOf": [
            {"$ref": "#/$defs/line_segment"},
            {"$ref": "#/$defs/polyline"},
            {"$ref": "#/$defs/route_graph"}
          ]
        }
      }
    },
    "conflict_zone_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "zone_id", "upstream_binding", "geometry"],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "zone_id": {"type": "string", "minLength": 1},
        "upstream_binding": {"$ref": "#/$defs/upstream_binding"},
        "geometry": {
          "oneOf": [
            {"$ref": "#/$defs/circle"},
            {"$ref": "#/$defs/point"},
            {"$ref": "#/$defs/polygon"}
          ]
        }
      }
    }
  }
}
