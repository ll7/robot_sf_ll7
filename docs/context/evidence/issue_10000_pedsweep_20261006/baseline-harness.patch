+def strip_map_pedestrians(candidate: Path, out_dir: Path) -> Path:
+    """Remove only SVG single-pedestrian circles from diagnostic copies, retaining walls/routes."""
+    import xml.etree.ElementTree as ET
+    root = ET.fromstring(candidate.read_bytes())
+    count = 0
+    for parent in root.iter():
+        for child in list(parent):
+            label = child.attrib.get("{http://www.inkscape.org/namespaces/inkscape}label", "")
+            if child.tag.rsplit("}", 1)[-1] == "circle" and label.startswith("single_ped_"):
+                parent.remove(child)
+                count += 1
+    if not count:
+        return candidate
+    target = out_dir / "actor_free_maps" / candidate.name
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_bytes(ET.tostring(root, encoding="utf-8", xml_declaration=True))
+    return target
 
 
