{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/issue_6814_packet_manifest.v1.json",
  "title": "Issue #6814 trace re-export packet manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "generation_time",
    "source_package",
    "source_contracts",
    "pair_compatibility_receipts",
    "output_hashes",
    "disposition",
    "check_results"
  ],
  "properties": {
    "schema_version": {"const": "issue_6814_packet_manifest.v1"},
    "issue": {"const": 6814},
    "generation_time": {"const": "deterministic-not-a-clock"},
    "source_package": {"$ref": "#/$defs/sourcePackage"},
    "source_contracts": {"$ref": "#/$defs/sourceContractFiles"},
    "pair_compatibility_receipts": {"$ref": "#/$defs/pairReceiptFiles"},
    "output_hashes": {"$ref": "#/$defs/outputHashes"},
    "disposition": {"enum": ["supported", "unsupported", "blocked"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "check_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_digest_ok",
        "row_contract_digest_ok",
        "artifact_integrity_ok",
        "deterministic_rebuild_ok"
      ],
      "properties": {
        "package_digest_ok": {"type": "boolean"},
        "row_contract_digest_ok": {"type": "boolean"},
        "artifact_integrity_ok": {"type": "boolean"},
        "deterministic_rebuild_ok": {"type": ["boolean", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["disposition"],
        "properties": {"disposition": {"const": "supported"}}
      },
      "then": {
        "properties": {
          "check_results": {
            "properties": {
              "package_digest_ok": {"const": true},
              "row_contract_digest_ok": {"const": true},
              "artifact_integrity_ok": {"const": true},
              "deterministic_rebuild_ok": {"const": true}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "manifest_uri",
        "manifest_sha256",
        "episodes_uri",
        "episodes_sha256",
        "run_summary_uri",
        "run_summary_sha256",
        "preflight_uri",
        "preflight_sha256",
        "n_rows"
      ],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "manifest_uri": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "episodes_uri": {"type": "string", "minLength": 1},
        "episodes_sha256": {"$ref": "#/$defs/sha256"},
        "run_summary_uri": {"type": "string", "minLength": 1},
        "run_summary_sha256": {"$ref": "#/$defs/sha256"},
        "preflight_uri": {"type": "string", "minLength": 1},
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "n_rows": {"type": "integer", "minimum": 1}
      }
    },
    "sourcePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_issue",
        "source_package_sha256sums_sha256",
        "package_manifest_uri",
        "package_manifest_sha256",
        "package_complete_uri",
        "package_complete_sha256",
        "mapping_receipt_uri",
        "mapping_receipt_sha256",
        "arms"
      ],
      "properties": {
        "source_issue": {"const": 6412},
        "source_package_sha256sums_sha256": {"$ref": "#/$defs/sha256"},
        "package_manifest_uri": {"type": "string", "minLength": 1},
        "package_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "package_complete_uri": {"type": "string", "minLength": 1},
        "package_complete_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_receipt_uri": {"type": "string", "minLength": 1},
        "mapping_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doorway_ppo",
            "double_bottleneck_goal",
            "double_bottleneck_ppo"
          ],
          "properties": {
            "doorway_ppo": {"$ref": "#/$defs/arm"},
            "double_bottleneck_goal": {"$ref": "#/$defs/arm"},
            "double_bottleneck_ppo": {"$ref": "#/$defs/arm"}
          }
        }
      }
    },
    "outputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_manifest_uri",
        "source_contracts_manifest_uri",
        "pair_receipts"
      ],
      "properties": {
        "package_manifest_uri": {"type": "string", "minLength": 1},
        "source_contracts_manifest_uri": {"type": "string", "minLength": 1},
        "pair_receipts": {"$ref": "#/$defs/pairReceiptFiles"}
      }
    },
    "traceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_id",
        "scenario_id",
        "seed",
        "episode_id",
        "job_id",
        "row_index",
        "execution_commit",
        "raw_trace_sha256",
        "prior_normalized_trace_sha256",
        "reexported_trace_sha256"
      ],
      "properties": {
        "planner_id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "episode_id": {"type": "string", "minLength": 1},
        "job_id": {"type": "string", "minLength": 1},
        "row_index": {"type": "integer", "minimum": 1},
        "execution_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "raw_trace_sha256": {"$ref": "#/$defs/sha256"},
        "prior_normalized_trace_sha256": {"$ref": "#/$defs/sha256"},
        "reexported_trace_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceContractFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "trace_identity"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["available", "unsupported", "unavailable", "blocked"]},
        "trace_identity": {"$ref": "#/$defs/traceIdentity"}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "available"}}
          },
          "then": {
            "properties": {
              "trace_identity": {
                "properties": {
                  "reexported_trace_sha256": {"$ref": "#/$defs/sha256"}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": {"enum": ["unsupported", "unavailable", "blocked"]}
            }
          },
          "then": {
            "properties": {
              "trace_identity": {
                "properties": {"reexported_trace_sha256": {"type": "null"}}
              }
            }
          }
        }
      ]
    },
    "sourceContractFiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/sourceContractFile"},
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"const": "source_contracts/doorway_ppo_113.json"},
              "trace_identity": {
                "properties": {
                  "planner_id": {"const": "ppo"},
                  "scenario_id": {"const": "classic_doorway_medium"},
                  "seed": {"const": 113},
                  "job_id": {"const": "13483"},
                  "row_index": {"const": 3},
                  "execution_commit": {"const": "a307ef276d701f8d14dead1aa0513f44ee97c0b0"}
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"const": "source_contracts/doorway_ppo_114.json"},
              "trace_identity": {
                "properties": {
                  "planner_id": {"const": "ppo"},
                  "scenario_id": {"const": "classic_doorway_medium"},
                  "seed": {"const": 114},
                  "job_id": {"const": "13483"},
                  "row_index": {"const": 4},
                  "execution_commit": {"const": "a307ef276d701f8d14dead1aa0513f44ee97c0b0"}
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"const": "source_contracts/double_bottleneck_goal_118.json"},
              "trace_identity": {
                "properties": {
                  "planner_id": {"const": "goal"},
                  "scenario_id": {"const": "classic_realworld_double_bottleneck_high"},
                  "seed": {"const": 118},
                  "job_id": {"const": "13487"},
                  "row_index": {"const": 8},
                  "execution_commit": {"const": "a307ef276d701f8d14dead1aa0513f44ee97c0b0"}
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"const": "source_contracts/double_bottleneck_ppo_118.json"},
              "trace_identity": {
                "properties": {
                  "planner_id": {"const": "ppo"},
                  "scenario_id": {"const": "classic_realworld_double_bottleneck_high"},
                  "seed": {"const": 118},
                  "job_id": {"const": "13488"},
                  "row_index": {"const": 8},
                  "execution_commit": {"const": "a307ef276d701f8d14dead1aa0513f44ee97c0b0"}
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "pairReceiptFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "pair_id", "disposition"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "pair_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["supported", "unsupported", "blocked"]}
      }
    },
    "pairReceiptFiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/pairReceiptFile"},
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"const": "pair_receipts/doorway_ppo_113_114.json"},
              "pair_id": {"const": "classic_doorway_medium--ppo--113-114"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"const": "pair_receipts/double_bottleneck_goal_118_118.json"},
              "pair_id": {
                "const": "classic_realworld_double_bottleneck_high--goal--118-118"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
