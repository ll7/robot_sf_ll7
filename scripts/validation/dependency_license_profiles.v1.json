{
  "$schema": "scripts/validation/dependency_license_profiles.v1.schema.json",
  "schema_version": "robot-sf.dependency-license-profiles.v1",
  "target": {
    "os": "linux",
    "architecture": "x86_64",
    "python": {
      "implementation": "CPython",
      "version": "3.13",
      "requires": ">=3.11"
    },
    "resolver": {
      "name": "uv",
      "version": "0.11.21",
      "lock_mode": "frozen"
    },
    "source_policy": {
      "indexes": ["https://pypi.org/simple"],
      "network": "lock-identity validation is offline; profile resolution must use frozen locks"
    }
  },
  "unrepresented_policy": {
    "schema_version": "robot-sf.dependency-license-unrepresented.v1",
    "rules": [
      {
        "id": "robot-sf-development-groups",
        "lockfile": "uv.lock",
        "root_package": "robot-sf",
        "field": "dev-dependencies",
        "groups": ["carla", "dev", "docs", "imitation"],
        "reason_code": "development_group",
        "reviewed": true,
        "rationale": "The root CARLA, development, documentation, and imitation groups are tooling or validation contexts, not supported user-installed release profiles. Their lock rows remain visible but are excluded only by this reviewed context rule."
      },
      {
        "id": "fast-pysf-development-extra",
        "lockfile": "fast-pysf/uv.lock",
        "root_package": "pysocialforce",
        "field": "optional-dependencies",
        "groups": ["dev"],
        "reason_code": "development_group",
        "reviewed": true,
        "rationale": "The standalone fast-pysf development extra is test and tooling support; runtime fast-pysf dependencies remain covered by the explicit fast-pysf profile."
      },
      {
        "id": "target-inactive-resolution-marker",
        "reason_code": "marker_inactive",
        "reviewed": true,
        "rationale": "A lock row whose explicit resolution-markers are false for the manifest target is resolver output for another supported environment, not membership in this target release surface."
      }
    ],
    "unresolved": {
      "id": "unresolved-membership-fallback",
      "reason_code": "unresolved_membership",
      "reviewed": false,
      "rationale": "No profile, reviewed development-group rule, or proven-false target marker explains this lock row. Keep it visible and fail strict mode closed until its membership is reviewed."
    }
  },
  "profiles": [
    {
      "id": "core",
      "kind": "root",
      "extras": [],
      "pyproject": "pyproject.toml",
      "lockfile": "uv.lock",
      "root_package": "robot-sf",
      "expected_resolution": "locked",
      "distribution_mode": "user_installed"
    },
    {
      "id": "viz",
      "kind": "root-extra",
      "extra": "viz",
      "extras": ["viz"],
      "pyproject": "pyproject.toml",
      "lockfile": "uv.lock",
      "root_package": "robot-sf",
      "expected_resolution": "locked",
      "distribution_mode": "user_installed"
    },
    {
      "id": "maps",
      "kind": "root-extra",
      "extra": "maps",
      "extras": ["maps"],
      "pyproject": "pyproject.toml",
      "lockfile": "uv.lock",
      "root_package": "robot-sf",
      "expected_resolution": "locked",
      "distribution_mode": "user_installed"
    },
    {
      "id": "benchmark",
      "kind": "root-extra",
      "extra": "benchmark",
      "extras": ["benchmark"],
      "pyproject": "pyproject.toml",
      "lockfile": "uv.lock",
      "root_package": "robot-sf",
      "expected_resolution": "locked",
      "distribution_mode": "user_installed"
    },
    {
      "id": "gpu",
