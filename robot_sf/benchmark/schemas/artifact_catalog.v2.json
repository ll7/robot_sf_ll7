{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/artifact_catalog.v2.json",
  "title": "Robot SF reusable artifact catalog with figure publication semantics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "artifacts"],
  "properties": {
    "schema_version": {
      "const": "artifact_catalog.v2"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "claim_identity": {
      "$ref": "#/$defs/claim_identity"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "claim_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "question", "estimand"],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "estimand": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "source_kind",
        "source_files",
        "outputs",
        "generation_command",
        "generation_commit",
        "claim_boundary"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "artifact_kind": {
          "enum": ["figure", "table"]
        },
        "source_kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/file_ref"
          },
          "propertyNames": {
            "pattern": "^[a-z0-9_.-]+$"
          }
        },
        "caption_file": {
          "$ref": "#/$defs/file_ref"
        },
        "generation_command": {
          "type": "string",
          "minLength": 1
        },
        "generation_commit": {
          "type": "string",
          "minLength": 7
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        },
        "figure_semantics": {
          "$ref": "#/$defs/figure_semantics"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "figure"
              }
            }
          },
          "then": {
            "required": ["caption_file", "figure_semantics"]
          }
        }
      ]
    },
    "figure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "unit",
        "desirability",
        "support",
        "denominator",
        "comparison",
        "uncertainty_declared",
        "tie_policy",
        "legend_series",
        "legend_complete"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "desirability": {
          "type": "string",
          "enum": [
            "higher_is_better",
            "lower_is_better",
            "target_range",
            "not_applicable"
          ]
        },
        "support": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "comparison": {
          "type": "boolean"
        },
        "uncertainty_declared": {
          "type": "boolean"
        },
        "uncertainty_method": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tie_policy": {
          "type": "string",
          "minLength": 1
        },
        "legend_series": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "legend_complete": {
          "type": "boolean"
        },
        "accessibility_palette_contract": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
