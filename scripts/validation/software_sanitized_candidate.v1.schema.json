{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.dev/schema/software_sanitized_candidate.v1.schema.json",
  "title": "Robot SF sanitized software candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_path",
    "policy_sha256",
    "source_sha",
    "source_tree_sha1",
    "candidate_commit_sha",
    "candidate_tree_sha1",
    "tree_sha256",
    "members",
    "excluded_members"
  ],
  "properties": {
    "schema_version": {"const": "robot_sf.software_sanitized_candidate.v1"},
    "policy_id": {"const": "robot_sf.software_release_rights_policy.v1"},
    "policy_path": {"const": "scripts/validation/software_release_rights_policy.v1.json"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "git_blob_sha1", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "enum": ["100644", "100755"]},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "excluded_members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["policy-excluded", "non-regular"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
