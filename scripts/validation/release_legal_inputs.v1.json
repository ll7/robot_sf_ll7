{
  "schema_version": "robot_sf.release_legal_inputs.v1",
  "surfaces": [
    {
      "id": "package-archive",
      "workflow": ".github/workflows/packaging-extras.yml",
      "job_id": "clean-wheel-extra",
      "check_context": "clean wheel [all]",
      "validator": "scripts/tools/check_distribution_licenses.py",
      "direct_globs": [
        "pyproject.toml",
        "uv.lock",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "fast-pysf/**",
        "third_party/python-rvo2/**",
        "third_party/socnavbench/**",
        "robot_sf/common/optional_import.py",
        "robot_sf/common/__init__.py",
        "robot_sf/benchmark/doctor.py",
        "robot_sf/gym_env/crowd_sim_env.py",
        "robot_sf/nav/osm_map_builder.py",
        "robot_sf/render/**",
        "scripts/validation/wheel_install_smoke.sh",
        "scripts/tools/check_distribution_licenses.py",
        "tests/tools/test_check_distribution_licenses.py",
        "scripts/validation/release_legal_inputs.v1.json",
        "scripts/tools/check_release_legal_input_coverage.py",
        "tests/dev/test_release_legal_input_coverage.py",
        ".github/workflows/packaging-extras.yml"
      ],
      "dynamic_inputs": [],
      "claim_boundary": "Built wheel and sdist legal payload only; no rights, benchmark, or publication claim."
    },
    {
      "id": "dependency-metadata",
      "workflow": ".github/workflows/dependency-review.yml",
      "job_id": "review",
      "check_context": "review",
      "validator": "actions/dependency-review-action",
      "direct_globs": [
        "pyproject.toml",
        "uv.lock",
        "fast-pysf/**",
        "third_party/python-rvo2/**",
        "third_party/socnavbench/**",
        ".github/dependabot.yml",
        ".github/workflows/dependency-review.yml",
        "scripts/validation/release_legal_inputs.v1.json",
        "scripts/tools/check_release_legal_input_coverage.py",
        "tests/dev/test_release_legal_input_coverage.py"
      ],
      "dynamic_inputs": [],
      "claim_boundary": "Dependency-change review only; not permission, rights, or release clearance."
    },
    {
      "id": "model-release",
      "workflow": ".github/workflows/model-license-preflight.yml",
      "job_id": "model-license-preflight",
      "check_context": "model-license-preflight",
      "validator": "scripts/tools/publish_model_registry_release.py --validate-licensing",
      "direct_globs": [
        "model/**",
        "scripts/tools/publish_model_registry_release.py",
        "tests/tools/test_publish_model_registry_release.py",
        "scripts/validation/release_legal_inputs.v1.json",
        "scripts/tools/check_release_legal_input_coverage.py",
        "tests/dev/test_release_legal_input_coverage.py",
        ".github/workflows/model-license-preflight.yml"
      ],
      "dynamic_inputs": [
        {
          "source": "model/registry.yaml",
          "fields": [
            "models[].licensing.license_file",
            "models[].licensing.model_card_file",
            "models[].licensing.included_notices[]"
          ]
        }
      ],
      "claim_boundary": "Read-only model legal-input completeness; no staging, upload, or registry write."
    },
    {
      "id": "coverage-contract",
      "workflow": ".github/workflows/release-legal-input-coverage.yml",
      "job_id": "release-legal-input-coverage",
      "check_context": "release-legal-input-coverage",
      "validator": "scripts/tools/check_release_legal_input_coverage.py",
      "direct_globs": [
        "scripts/validation/release_legal_inputs.v1.json",
        "scripts/tools/check_release_legal_input_coverage.py",
        "tests/dev/test_release_legal_input_coverage.py",
        ".github/workflows/**"
      ],
      "dynamic_inputs": [],
      "claim_boundary": "Routing and ownership contract only; no rights or publication verdict."
    }
  ]
}
