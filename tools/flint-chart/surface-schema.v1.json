{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ll7/robot_sf_ll7/blob/main/tools/flint-chart/surface-schema.v1.json",
  "title": "Flint analysis-only surface candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface_id",
    "figure_id",
    "metric",
    "source_context",
    "source",
    "display_population",
    "coverage",
    "cells",
    "tie_groups",
    "parity",
    "renderer_policy",
    "render_status",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "flint-chart-surface.v1"},
    "surface_id": {"type": "string", "minLength": 1},
    "figure_id": {"type": "string", "minLength": 1},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "source_context": {"enum": ["release", "replay"]},
    "source": {"$ref": "#/$defs/source"},
    "display_population": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/populationItem"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expected_cells",
        "actual_cells",
        "missing_cells",
        "duplicate_cells",
        "dropped_cells"
      ],
      "properties": {
        "status": {"const": "complete"},
        "expected_cells": {"type": "integer", "minimum": 1},
        "actual_cells": {"type": "integer", "minimum": 1},
        "missing_cells": {"type": "array", "maxItems": 0},
        "duplicate_cells": {"type": "array", "maxItems": 0},
        "dropped_cells": {"type": "array", "maxItems": 0}
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/outputCell"}
    },
    "tie_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "scenario_family", "value", "members"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "scenario_family": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "string", "minLength": 1},
                {"type": "string", "minLength": 1}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "compared_cells", "compared_fields", "missing_cells", "extra_cells"],
      "properties": {
        "status": {"const": "passed"},
        "compared_cells": {"type": "integer", "minimum": 1},
        "compared_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "missing_cells": {"type": "array", "maxItems": 0},
        "extra_cells": {"type": "array", "maxItems": 0}
      }
    },
    "renderer_policy": {"$ref": "#/$defs/outputRendererPolicy"},
    "render_status": {"const": "not_run"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "source_commit",
        "release_id",
        "artifact_catalog",
        "input_hashes",
        "durability"
      ],
      "properties": {
        "context": {"enum": ["release", "replay"]},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_id": {"type": "string", "minLength": 1},
        "artifact_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "input_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "durability": {"const": "durable_pinned"}
      }
    },
    "populationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner_key", "scenario_family"],
      "properties": {
        "planner_key": {"type": "string", "minLength": 1},
        "scenario_family": {"type": "string", "minLength": 1}
      }
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "lower", "upper", "method"],
          "properties": {
            "status": {"const": "available"},
            "lower": {"type": "number"},
            "upper": {"type": "number"},
            "method": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unavailable"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "outputCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_key",
        "scenario_family",
        "value",
        "denominator",
        "exposure_definition",
        "exclusions",
        "uncertainty",
        "capability_track",
        "evidence_status",
        "rank",
        "tie_group"
      ],
      "properties": {
        "planner_key": {"type": "string", "minLength": 1},
        "scenario_family": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "denominator": {"type": "integer", "minimum": 0},
        "exposure_definition": {"type": "string", "minLength": 1},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "capability_track": {"type": "string", "minLength": 1},
        "evidence_status": {"type": "string", "minLength": 1},
        "rank": {"type": ["integer", "null"]},
        "tie_group": {"type": ["string", "null"]}
      }
    },
    "outputRendererPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_renderer",
        "tie_policy",
        "source_context_separation"
      ],
      "properties": {
        "canonical_renderer": {"const": "matplotlib/pgf/tikz"},
        "tie_policy": {"const": "exact_ties_no_catalog_rank"},
        "source_context_separation": {"const": true},
        "requires_uncertainty": {"type": "boolean"},
        "requires_direct_labels": {"type": "boolean"},
        "requires_tie_preservation": {"type": "boolean"}
      }
    }
  }
}
