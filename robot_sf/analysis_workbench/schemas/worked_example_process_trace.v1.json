{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/worked_example_process_trace.v1.json",
  "title": "Robot SF Worked Example Process Trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "process_trace_id",
    "analysis_input_contract",
    "analysis_input_sha256",
    "source_trace",
    "evidence_boundary",
    "source_coordinate_frame",
    "units",
    "claim_boundary",
    "profiles",
    "coordinate_frames",
    "encounters",
    "frames",
    "diagnostics",
    "event_anchors",
    "event_anchor_hierarchy",
    "pair_compatibility"
  ],
  "properties": {
    "schema_version": {"const": "worked_example_process_trace.v1"},
    "process_trace_id": {"type": "string", "minLength": 1},
    "analysis_input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_trace_content_sha256",
        "route",
        "conflict",
        "pair_trace",
        "encounter_report",
        "focal_actor_id",
        "focal_encounter_id",
        "pair_comparison_grain"
      ],
      "properties": {
        "schema_version": {"const": "worked_example_process_trace_analysis_input.v1"},
        "source_trace_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "route": {"$ref": "#/$defs/geometry_input_contract"},
        "conflict": {"$ref": "#/$defs/geometry_input_contract"},
        "pair_trace": {"$ref": "#/$defs/analysis_pair_input"},
        "encounter_report": {"$ref": "#/$defs/analysis_report_input"},
        "focal_actor_id": {"type": ["string", "null"]},
        "focal_encounter_id": {"type": ["string", "null"]},
        "pair_comparison_grain": {
          "enum": ["matched_planner_pair", "matched_realization_pair", null]
        }
      }
    },
    "analysis_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "trace_id",
        "coordinate_frame",
        "units",
        "content_sha256",
        "content_receipt",
        "run_config_contract",
        "source"
      ],
      "properties": {
        "schema_version": {"const": "simulation_trace_export.v1"},
        "trace_id": {"type": "string", "minLength": 1},
        "coordinate_frame": {"type": "string", "minLength": 1},
        "units": {"type": "object"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_receipt": {"$ref": "#/$defs/trace_content_receipt"},
        "run_config_contract": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": {"const": "unavailable"},
                "reason": {"type": "string"},
                "time_step_s": {"type": "number", "exclusiveMinimum": 0},
                "observed_time_step_s": {"type": "number", "exclusiveMinimum": 0},
                "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "source": {"const": "planner.run_config"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "time_step_s", "config_digest", "source"],
              "properties": {
                "status": {"const": "available"},
                "time_step_s": {"type": "number", "exclusiveMinimum": 0},
                "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "source": {"const": "planner.run_config"}
              }
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario_id", "seed", "planner_id", "episode_id", "generated_by"],
          "properties": {
            "scenario_id": {"type": "string"},
            "seed": {"type": "integer"},
            "planner_id": {"type": "string"},
            "episode_id": {"type": "string"},
            "generated_by": {"type": "string"}
          }
        }
      }
    },
    "evidence_boundary": {"const": "analysis_workbench_only"},
    "source_coordinate_frame": {"type": "string", "minLength": 1},
    "units": {"type": "object"},
    "claim_boundary": {"const": "Diagnostic renderer-neutral process quantities derived from admitted trace fields. Not calibrated AMMV safety thresholds, collision probabilities, causal attribution, or replacement benchmark metrics."},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_anchor_profile",
        "threshold_profile",
        "phase_profile",
        "reversal_profile",
        "safety_surrogate_profile"
      ],
      "properties": {
        "event_anchor_profile": {"$ref": "#/$defs/profile"},
        "threshold_profile": {"$ref": "#/$defs/profile"},
        "phase_profile": {"$ref": "#/$defs/profile"},
        "reversal_profile": {"$ref": "#/$defs/profile"},
        "safety_surrogate_profile": {"$ref": "#/$defs/profile"}
      }
    },
    "coordinate_frames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "route", "conflict", "relative_interaction"],
      "properties": {
        "world": {"$ref": "#/$defs/availability"},
        "route": {"$ref": "#/$defs/geometry_availability"},
        "conflict": {"$ref": "#/$defs/geometry_availability"},
        "relative_interaction": {"$ref": "#/$defs/availability"}
      }
    },
    "encounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focal", "global_minimum_over_all_actors", "actor_switch_events"],
      "properties": {
        "focal": {"$ref": "#/$defs/focal_encounter"},
        "global_minimum_over_all_actors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "series"],
          "properties": {
            "status": {"type": "string"},
            "reason": {"type": "string"},
            "series": {"type": "array", "items": {"type": "object"}}
          }
        },
        "actor_switch_events": {"type": "array", "items": {"type": "object"}}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_index",
          "step",
          "time_s",
          "source_coordinates",
          "encounter_interval",
          "world",
          "route",
          "conflict",
          "relative_interaction",
          "global_minimum_actor",
          "commands",
          "event_alignment"
        ],
        "properties": {
          "frame_index": {"type": "integer"},
          "step": {"type": "integer"},
          "time_s": {"type": "number"},
          "source_coordinates": {"$ref": "#/$defs/source_coordinates_frame"},
          "encounter_interval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": {"enum": ["in_interval", "outside_interval"]},
              "reason": {"type": "string"}
            }
          },
          "world": {"$ref": "#/$defs/world_frame"},
          "route": {"$ref": "#/$defs/route_frame"},
          "conflict": {"$ref": "#/$defs/conflict_frame"},
          "relative_interaction": {"$ref": "#/$defs/relative_interaction"},
          "global_minimum_actor": {"$ref": "#/$defs/global_minimum_actor"},
          "commands": {"$ref": "#/$defs/commands_frame"},
          "event_alignment": {"$ref": "#/$defs/event_alignment"}
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_proxy_surface_clearance_m",
        "threshold_exposure",
        "route_progress",
        "stall",
        "conflict_zone_occupancy",
        "reversal_counts"
        ,"coverage"
      ],
      "properties": {
        "minimum_proxy_surface_clearance_m": {"type": ["number", "null"]},
        "threshold_exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_version",
            "threshold_m",
            "duration_s",
            "integrated_clearance_deficit_m_s",
            "status"
          ],
          "properties": {
            "profile_version": {"type": "string"},
            "threshold_m": {"type": "number"},
            "duration_s": {"type": ["number", "null"]},
            "integrated_clearance_deficit_m_s": {"type": ["number", "null"]},
            "status": {"type": "string"},
            "reason": {"type": "string"}
          }
        },
        "route_progress": {"$ref": "#/$defs/route_progress"},
        "stall": {"$ref": "#/$defs/stall_diagnostic"},
        "conflict_zone_occupancy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "robot_duration_s", "focal_actor_duration_s"],
          "properties": {
            "status": {"type": "string"},
            "reason": {"type": "string"},
            "robot_duration_s": {"type": ["number", "null"]},
            "focal_actor_duration_s": {"type": ["number", "null"]}
          }
        },
        "reversal_counts": {"$ref": "#/$defs/reversal_counts"}
        ,"coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_count", "relative_interaction", "proxy_surface_clearance"],
          "properties": {
            "frame_count": {"type": "integer", "minimum": 0},
            "relative_interaction": {"$ref": "#/$defs/coverage_record"},
            "proxy_surface_clearance": {"$ref": "#/$defs/coverage_record"}
          }
        }
      }
    },
    "event_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "detector_profile_version",
          "status",
          "confidence",
          "actor_id",
          "zone_id",
          "source_fields",
          "event_relative_time",
          "visual_anchor_eligibility"
        ],
        "properties": {
          "event_id": {"type": "string"},
          "event_type": {
            "enum": [
              "minimum_clearance",
              "first_material_deceleration",
              "first_material_turn_response",
              "conflict_zone_entry",
              "exact_collision_event",
              "first_safety_predicate_breach",
              "proxy_overlap_event",
              "sustained_stall_onset",
              "recovery_onset",
              "terminal_event"
            ]
          },
          "detector_profile_version": {"type": "string"},
          "status": {"enum": ["available", "unavailable", "not_observed"]},
          "confidence": {"type": "string"},
          "time_s": {"type": "number"},
          "step": {"type": "integer"},
          "actor_id": {"type": ["string", "null"]},
          "zone_id": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "collision_observed": {"type": "boolean"},
          "collision_partner_id": {"type": ["string", "null"]},
          "collision_partner_type": {"type": ["string", "null"]},
          "focal_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": {"enum": ["available", "unavailable"]},
              "reason": {"type": "string"},
              "actor_id": {"type": "string"}
            }
          },
          "source_fields": {"type": "array", "items": {"type": "string"}},
          "event_relative_time": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"enum": ["available", "unavailable"]},
              "anchor_time_s": {"type": "number"},
              "tau_s": {"type": "number"},
              "reason": {"type": "string"}
            }
          },
          "visual_anchor_eligibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eligible", "reason"],
            "properties": {
              "eligible": {"type": "boolean"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "event_anchor_hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fallback_order", "available_anchors", "selected_anchor", "anchor_time_s"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "fallback_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "available_anchors": {"type": "array", "items": {"$ref": "#/$defs/hierarchy_anchor"}},
        "selected_anchor": {"anyOf": [{"$ref": "#/$defs/hierarchy_anchor"}, {"type": "null"}]},
        "anchor_time_s": {"type": ["number", "null"]}
      }
    },
    "pair_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "status",
        "comparison_grain",
        "provenance_gate",
        "right_source_trace",
        "initial_state_equivalence",
        "route_spawn_separation",
        "shared_prefix",
        "valid_common_event_anchors",
        "right_event_anchors",
        "right_coordinate_input_contract",
        "divergence_interpretation"
      ],
      "properties": {
        "profile_version": {"type": "string"},
        "status": {"enum": ["available", "unavailable", "incompatible"]},
        "reason": {"type": "string"},
        "comparison_grain": {
          "type": "object",
          "additionalProperties": true,
          "required": ["grain_id"],
          "properties": {
            "grain_id": {"enum": ["matched_planner_pair", "matched_realization_pair", "undeclared"]}
          }
        },
        "provenance_gate": {"$ref": "#/$defs/pair_provenance_gate"},
        "right_source_trace": {"$ref": "#/$defs/pair_source_trace"},
        "initial_state_equivalence": {"$ref": "#/$defs/pair_initial_state_equivalence"},
        "route_spawn_separation": {"$ref": "#/$defs/pair_route_spawn_separation"},
        "shared_prefix": {"$ref": "#/$defs/pair_shared_prefix"},
        "valid_common_event_anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/common_event_anchor"}
        },
        "right_event_anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/event_receipt"}
        },
        "right_coordinate_input_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "conflict"],
          "properties": {
            "route": {"$ref": "#/$defs/geometry_input_contract"},
            "conflict": {"$ref": "#/$defs/geometry_input_contract"}
          }
        },
        "duration_normalization": {"type": "object"},
        "divergence_interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "reason"],
          "properties": {
            "allowed": {"type": "boolean"},
            "reason": {"type": "string"}
          }
        }
      }
    }
  },
  "$defs": {
    "event_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "anchor_event_id": {"type": "string"},
        "anchor_event_type": {"type": "string"},
        "anchor_time_s": {"type": "number"},
        "tau_s": {"type": "number"},
        "reason": {"type": "string"}
      }
    },
    "hierarchy_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "event_type", "event_id", "time_s", "selection_role"],
      "properties": {
        "rank": {"type": "integer", "minimum": 0},
        "event_type": {
          "enum": [
            "exact_collision_event",
            "minimum_clearance",
            "first_safety_predicate_breach",
            "sustained_stall_onset",
            "terminal_event"
          ]
        },
        "event_id": {"type": "string"},
        "time_s": {"type": "number"},
        "selection_role": {"enum": ["first_safety_predicate_breach", "fallback_anchor"]}
      }
    },
    "focal_encounter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "actor_id": {"type": "string"},
        "encounter_id": {"type": ["string", "null"]},
        "declared_encounter": {"type": "object"},
        "actor_contiguity": {"$ref": "#/$defs/actor_contiguity"}
      }
    },
    "actor_contiguity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unavailable"},
            "reason": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "actor_id",
            "contiguous",
            "missing_steps",
            "reason",
            "computed_available_duration_s",
            "computed_min_proxy_surface_clearance_m",
            "canonical_encounter_record_status"
          ],
          "properties": {
            "status": {"const": "available"},
            "actor_id": {"type": "string"},
            "contiguous": {"type": "boolean"},
            "missing_steps": {"type": "array", "items": {"type": "integer"}},
            "reason": {"type": "string"},
            "computed_available_duration_s": {"type": ["number", "null"]},
            "computed_min_proxy_surface_clearance_m": {"type": ["number", "null"]},
            "canonical_encounter_record_status": {
              "enum": ["available", "unavailable"]
            }
          }
        }
      ]
    },
    "pair_provenance_gate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "compatible", "reason"],
          "properties": {
            "status": {"const": "unavailable"},
            "compatible": {"const": false},
            "reason": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "compatible",
            "checks",
            "availability",
            "time_step_contracts",
            "comparison_grain",
            "left_trace_id",
            "right_trace_id",
            "left_content_sha256",
            "right_content_sha256"
          ],
          "properties": {
            "status": {"const": "available"},
            "compatible": {"type": "boolean"},
            "checks": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "boolean"}
            },
            "availability": {"type": "object"},
            "time_step_contracts": {"type": "object"},
            "comparison_grain": {
              "enum": ["matched_planner_pair", "matched_realization_pair"]
            },
            "left_trace_id": {"type": "string"},
            "right_trace_id": {"type": "string"},
            "left_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "right_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "pair_initial_state_equivalence": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"type": "string"},
        "equivalent": {"type": "boolean"},
        "actor_id_sets_equal": {"type": "boolean"},
        "robot_position_delta_m": {"type": ["number", "null"]},
        "robot_velocity_delta_mps": {"type": ["number", "null"]},
        "robot_heading_delta_rad": {"type": ["number", "null"]},
        "robot_radius_delta_m": {"type": ["number", "null"]},
        "max_actor_position_delta_m": {"type": ["number", "null"]},
        "max_actor_velocity_delta_mps": {"type": ["number", "null"]},
        "max_actor_radius_delta_m": {"type": ["number", "null"]},
        "position_tolerance_m": {"type": "number"},
        "heading_tolerance_rad": {"type": "number"},
        "actor_position_delta_m": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "actor_velocity_delta_mps": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "actor_radius_delta_m": {
          "type": "object",
          "additionalProperties": {"type": ["number", "null"]}
        }
      }
    },
    "pair_route_spawn_separation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"type": "string"},
        "scenario_provenance_compatible": {"type": "boolean"},
        "scenario_id_equal": {"type": "boolean"},
        "planner_id_left": {"type": "string"},
        "planner_id_right": {"type": "string"},
        "seed_left": {"type": "integer"},
        "seed_right": {"type": "integer"},
        "initial_robot_separation_m": {"type": ["number", "null"]},
        "max_initial_actor_separation_m": {"type": ["number", "null"]}
      }
    },
    "pair_shared_prefix": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"type": "string"},
        "shared_prefix": {"type": "boolean"},
        "matched_steps": {"type": "integer", "minimum": 0},
        "required_steps": {"type": "integer", "minimum": 0},
        "position_tolerance_m": {"type": "number"},
        "heading_tolerance_rad": {"type": "number"}
      }
    },
    "coverage_record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "available_frame_count", "missing_frame_count"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "frame_count": {"type": "integer", "minimum": 0},
        "available_frame_count": {"type": "integer", "minimum": 0},
        "missing_frame_count": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"}
      }
    },
    "actor_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "heading", "velocity", "radius_m"],
      "properties": {
        "position": {"$ref": "#/$defs/vector2_or_empty"},
        "heading": {"type": ["number", "null"]},
        "velocity": {"$ref": "#/$defs/vector2_or_empty"},
        "radius_m": {"type": ["number", "null"]}
      }
    },
    "vector2_or_empty": {
      "type": "array",
      "items": {"type": "number"},
      "oneOf": [{"minItems": 0, "maxItems": 0}, {"minItems": 2, "maxItems": 2}]
    },
    "source_coordinates_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_frame", "robot", "focal_actor_id", "focal_actor", "contextual_actors"],
      "properties": {
        "coordinate_frame": {"type": "string", "minLength": 1},
        "robot": {"$ref": "#/$defs/actor_state"},
        "focal_actor_id": {"type": ["string", "null"]},
        "focal_actor": {"anyOf": [{"$ref": "#/$defs/actor_state"}, {"type": "null"}]},
        "contextual_actors": {"type": "array", "items": {"$ref": "#/$defs/source_actor_state"}}
      }
    },
    "source_actor_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "position", "heading", "velocity", "radius_m"],
      "properties": {
        "actor_id": {"type": "string"},
        "position": {"$ref": "#/$defs/vector2_or_empty"},
        "heading": {"type": ["number", "null"]},
        "velocity": {"$ref": "#/$defs/vector2_or_empty"},
        "radius_m": {"type": ["number", "null"]}
      }
    },
    "world_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "robot", "focal_actor"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"type": "string"},
        "robot": {"$ref": "#/$defs/actor_state"},
        "focal_actor": {"anyOf": [{"$ref": "#/$defs/actor_state"}, {"type": "null"}]}
      }
    },
    "line_segment_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "end"],
      "properties": {
        "type": {"const": "line_segment"},
