{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/component_request.v1.json",
  "$title": "Robot SF Component Request v1",
  "description": "Fixture request envelope for a review-contract component invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "component_id", "sources", "output_directory"],
  "properties": {
    "schema_version": {"const": "component-request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "uri", "format"],
          "properties": {
            "artifact_id": {"type": "string", "minLength": 1},
            "uri": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1},
            "schema": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
            "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "config_identity": {"type": "string"},
            "units": {"type": "string"},
            "coordinate_frame": {"type": "string"}
          }
      }
    },
    "config": {"type": "object", "additionalProperties": true},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_directory": {"type": "string", "minLength": 1}
  }
}
