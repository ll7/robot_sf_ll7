{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/worked_example_process_trace.v1.json",
  "title": "Robot SF Worked Example Process Trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "process_trace_id",
    "source_trace",
    "evidence_boundary",
    "source_coordinate_frame",
    "units",
    "claim_boundary",
    "profiles",
    "coordinate_frames",
    "encounters",
    "frames",
    "diagnostics",
    "event_anchors",
    "event_anchor_hierarchy",
    "pair_compatibility"
  ],
  "properties": {
    "schema_version": {"const": "worked_example_process_trace.v1"},
    "process_trace_id": {"type": "string", "minLength": 1},
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "coordinate_frame", "units", "source"],
      "properties": {
        "schema_version": {"const": "simulation_trace_export.v1"},
        "trace_id": {"type": "string", "minLength": 1},
        "coordinate_frame": {"type": "string", "minLength": 1},
        "units": {"type": "object"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario_id", "seed", "planner_id", "episode_id", "generated_by"],
          "properties": {
            "scenario_id": {"type": "string"},
            "seed": {"type": "integer"},
            "planner_id": {"type": "string"},
            "episode_id": {"type": "string"},
            "generated_by": {"type": "string"}
          }
        }
      }
    },
    "evidence_boundary": {"const": "analysis_workbench_only"},
    "source_coordinate_frame": {"type": "string", "minLength": 1},
    "units": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_anchor_profile",
        "threshold_profile",
        "phase_profile",
        "reversal_profile",
        "safety_surrogate_profile"
      ],
      "properties": {
        "event_anchor_profile": {"$ref": "#/$defs/profile"},
        "threshold_profile": {"$ref": "#/$defs/profile"},
        "phase_profile": {"$ref": "#/$defs/profile"},
        "reversal_profile": {"$ref": "#/$defs/profile"},
        "safety_surrogate_profile": {"$ref": "#/$defs/profile"}
      }
    },
    "coordinate_frames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "route", "conflict", "relative_interaction"],
      "properties": {
        "world": {"$ref": "#/$defs/availability"},
        "route": {"$ref": "#/$defs/availability"},
        "conflict": {"$ref": "#/$defs/availability"},
        "relative_interaction": {"$ref": "#/$defs/availability"}
      }
    },
    "encounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focal", "global_minimum_over_all_actors", "actor_switch_events"],
      "properties": {
        "focal": {"$ref": "#/$defs/focal_encounter"},
        "global_minimum_over_all_actors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "series"],
          "properties": {
            "status": {"type": "string"},
            "reason": {"type": "string"},
            "series": {"type": "array", "items": {"type": "object"}}
          }
        },
        "actor_switch_events": {"type": "array", "items": {"type": "object"}}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_index",
          "step",
          "time_s",
          "source_coordinates",
          "world",
          "route",
          "conflict",
          "relative_interaction",
          "global_minimum_actor",
          "commands"
        ],
        "properties": {
          "frame_index": {"type": "integer"},
          "step": {"type": "integer"},
          "time_s": {"type": "number"},
          "source_coordinates": {"type": "object"},
          "world": {"type": "object"},
          "route": {"type": "object"},
          "conflict": {"type": "object"},
          "relative_interaction": {"type": "object"},
          "global_minimum_actor": {"type": "object"},
          "commands": {"type": "object"}
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_proxy_surface_clearance_m",
        "threshold_exposure",
        "route_progress",
        "stall",
        "conflict_zone_occupancy",
        "reversal_counts"
        ,"coverage"
      ],
      "properties": {
        "minimum_proxy_surface_clearance_m": {"type": ["number", "null"]},
        "threshold_exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_version",
            "threshold_m",
            "duration_s",
            "integrated_clearance_deficit_m_s",
            "status"
          ],
          "properties": {
            "profile_version": {"type": "string"},
            "threshold_m": {"type": "number"},
            "duration_s": {"type": ["number", "null"]},
            "integrated_clearance_deficit_m_s": {"type": ["number", "null"]},
            "status": {"type": "string"},
            "reason": {"type": "string"}
          }
        },
        "route_progress": {"type": "object"},
        "stall": {"type": "object"},
        "conflict_zone_occupancy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "robot_duration_s", "focal_actor_duration_s"],
          "properties": {
            "status": {"type": "string"},
            "reason": {"type": "string"},
            "robot_duration_s": {"type": ["number", "null"]},
            "focal_actor_duration_s": {"type": ["number", "null"]}
          }
        },
        "reversal_counts": {"type": "object"}
        ,"coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_count", "relative_interaction", "proxy_surface_clearance"],
          "properties": {
            "frame_count": {"type": "integer", "minimum": 1},
            "relative_interaction": {"$ref": "#/$defs/coverage_record"},
            "proxy_surface_clearance": {"$ref": "#/$defs/coverage_record"}
          }
        }
      }
    },
    "event_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "detector_profile_version",
          "status",
          "confidence",
          "actor_id",
          "zone_id",
          "source_fields",
          "visual_anchor_eligibility"
        ],
        "properties": {
          "event_id": {"type": "string"},
          "event_type": {
            "enum": [
              "minimum_clearance",
              "first_material_deceleration",
              "first_material_turn_response",
              "conflict_zone_entry",
              "exact_collision_event",
              "proxy_overlap_event",
              "sustained_stall_onset",
              "recovery_onset",
              "trace_end_boundary"
            ]
          },
          "detector_profile_version": {"type": "string"},
          "status": {"enum": ["available", "unavailable", "not_observed"]},
          "confidence": {"type": "string"},
          "time_s": {"type": "number"},
          "step": {"type": "integer"},
          "actor_id": {"type": ["string", "null"]},
          "zone_id": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "source_fields": {"type": "array", "items": {"type": "string"}},
          "event_relative_coordinates": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status"],
            "properties": {"status": {"enum": ["available", "unavailable"]}}
          },
          "visual_anchor_eligibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eligible", "reason"],
            "properties": {
              "eligible": {"type": "boolean"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "event_anchor_hierarchy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "event_type", "event_id", "status"],
        "properties": {
          "rank": {"type": "integer", "minimum": 0},
          "event_type": {"type": "string"},
          "event_id": {"type": "string"},
          "status": {"enum": ["available", "unavailable", "not_observed"]}
        }
      }
    },
    "pair_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "status",
        "comparison_grain",
        "provenance_gate",
        "initial_state_equivalence",
        "route_spawn_separation",
        "shared_prefix",
        "valid_common_event_anchors",
        "divergence_interpretation"
      ],
      "properties": {
        "profile_version": {"type": "string"},
        "status": {"enum": ["available", "unavailable", "incompatible"]},
        "reason": {"type": "string"},
        "comparison_grain": {"type": "object", "minProperties": 1},
        "provenance_gate": {"type": "object", "minProperties": 1},
        "initial_state_equivalence": {"type": "object"},
        "route_spawn_separation": {"type": "object"},
        "shared_prefix": {"type": "object"},
        "valid_common_event_anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/common_event_anchor"}
        },
        "duration_normalization": {"type": "object"},
        "divergence_interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "reason"],
          "properties": {
            "allowed": {"type": "boolean"},
            "reason": {"type": "string"}
          }
        }
      }
    }
  },
  "$defs": {
    "focal_encounter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "actor_id": {"type": "string"},
        "encounter_id": {"type": ["string", "null"]},
        "declared_encounter": {"type": "object"}
      }
    },
    "coverage_record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "available_frame_count", "missing_frame_count", "reason"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "available_frame_count": {"type": "integer", "minimum": 0},
        "missing_frame_count": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"}
      }
    },
    "common_event_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "detector_profile_version",
        "actor_id",
        "zone_id",
        "source_fields",
        "status",
        "left_event_id",
        "right_event_id"
      ],
      "properties": {
        "event_type": {"type": "string"},
        "detector_profile_version": {"type": "string"},
        "actor_id": {"type": ["string", "null"]},
        "zone_id": {"type": ["string", "null"]},
        "source_fields": {"type": "array", "items": {"type": "string"}},
        "status": {"const": "available"},
        "left_event_id": {"type": "string"},
        "right_event_id": {"type": "string"}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"type": "string"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profile_version"],
      "properties": {"profile_version": {"type": "string", "minLength": 1}}
    }
  }
}
