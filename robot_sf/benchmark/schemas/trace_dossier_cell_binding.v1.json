{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/trace_dossier_cell_binding.v1.json",
  "title": "Trace dossier campaign-cell binding metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell",
    "selected_trace",
    "terminal_verdict_counts",
    "cell_episode_count",
    "selected_verdict_count",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "trace_dossier_cell_binding.v1"},
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "cell_id", "scenario_id", "planner_id"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "cell_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "scenario_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "planner_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "release_arm_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "scenario_family": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "selected_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "episode_id",
        "seed",
        "trace_artifact_uri",
        "trace_sha256",
        "terminal_verdict"
      ],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "episode_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "seed": {"type": "integer", "minimum": 0},
        "trace_artifact_uri": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "terminal_verdict": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
      }
    },
    "terminal_verdict_counts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": ".*\\S.*"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "cell_episode_count": {"type": "integer", "minimum": 1},
    "selected_verdict_count": {"type": "integer", "minimum": 1},
    "evidence_boundary": {
      "const": "metadata_only_not_benchmark_evidence_until_trace_export_and_renderer_provenance_pass"
    }
  }
}
