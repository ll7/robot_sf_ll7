{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/robot-sf/adversarial-counterexample-corpus.v1.json",
  "title": "Robot SF Adversarial Counterexample Corpus (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_boundary",
    "search_runs",
    "cases",
    "admission_attempts",
    "planner_evaluations"
  ],
  "properties": {
    "schema_version": {
      "const": "adversarial-counterexample-corpus.v1"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "search_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "run_id",
          "source_issue",
          "source_revision",
          "objective",
          "search_space",
          "attempted_candidates",
          "completed_candidates",
          "failed_candidates",
          "invalid_candidates",
          "new_counterexamples_discovered",
          "new_counterexamples_admitted",
          "evidence_tier",
          "source_files",
          "manifest_files"
        ],
        "properties": {
          "schema_version": {"const": "adversarial-counterexample-search-run.v1"},
          "run_id": {"type": "string", "minLength": 1},
          "source_issue": {"type": "integer", "minimum": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "objective": {"type": "object"},
          "search_space": {"type": "object"},
          "attempted_candidates": {"type": "integer", "minimum": 0},
          "completed_candidates": {"type": "integer", "minimum": 0},
          "failed_candidates": {"type": "integer", "minimum": 0},
          "invalid_candidates": {"type": "integer", "minimum": 0},
          "new_counterexamples_discovered": {"type": "integer", "minimum": 0},
          "new_counterexamples_admitted": {"type": "integer", "minimum": 0},
          "evidence_tier": {"type": "string", "minLength": 1},
          "source_files": {"type": "array", "items": {"type": "object"}},
          "manifest_files": {"type": "array", "items": {"type": "object"}},
          "bundle_receipts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_path", "path", "sha256"],
              "properties": {
                "source_path": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "case_id",
          "effective_scenario_sha256",
          "scenario_id",
          "scenario_seed",
          "inputs",
          "structural_validation",
          "discovery",
          "admissibility",
          "target_planner",
          "replay_receipt",
          "source_evidence"
        ],
        "properties": {
          "schema_version": {"const": "adversarial-counterexample.v1"},
          "case_id": {"type": "string", "minLength": 1},
          "effective_scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "scenario_id": {"type": "string", "minLength": 1},
          "scenario_seed": {"type": "integer"},
          "inputs": {"type": "object"},
          "structural_validation": {"type": "object"},
          "discovery": {"type": "object"},
          "admissibility": {"type": "object"},
          "target_planner": {"type": "object"},
          "replay_receipt": {"type": "object"},
          "source_evidence": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "historical_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "candidate_id",
          "source_issue",
          "source_case_id",
          "source_record_sha256",
          "source_provenance",
          "candidate_status",
          "source_replay_status",
          "source_replay",
          "scenario_id",
          "scenario_family",
          "scenario_seed",
          "benchmark_eligible",
          "target_planner",
          "criticality",
          "replay_inputs",
          "artifact_paths"
        ],
        "properties": {
          "schema_version": {"const": "adversarial-historical-candidate.v1"},
          "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_issue": {"const": 9656},
          "source_case_id": {"type": "string", "pattern": "^case-[0-9a-f]{16}$"},
          "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_provenance": {"type": "object"},
          "candidate_status": {
            "enum": [
              "pending_exact_replay",
              "blocked_unavailable_model_artifact",
              "blocked_replay_revision_mismatch",
              "blocked_source_provenance_mismatch"
            ]
          },
          "source_replay_status": {
            "enum": [
              "not_attempted",
              "unavailable_model_artifact",
              "mismatch_different_revision"
            ]
          },
          "source_replay": {"type": "object"},
          "scenario_id": {"type": "string", "minLength": 1},
          "scenario_family": {"type": "string", "minLength": 1},
          "scenario_seed": {"type": "integer"},
          "benchmark_eligible": {"type": "boolean"},
          "target_planner": {"type": "object"},
          "criticality": {"type": "object"},
          "replay_inputs": {"type": "object"},
          "artifact_paths": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "historical_candidate_imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "import_id",
          "source_issue",
          "source_identity",
          "source_files",
          "candidate_ids",
          "candidate_count",
          "source_rows_verified",
          "candidate_status_counts",
          "source_replay_status_counts",
          "criticality_anomaly_counts",
          "failed_replay_attempts",
          "failed_setup_jobs",
          "evidence_tier",
          "claim_boundary",
          "artifact_paths"
        ],
        "properties": {
          "schema_version": {"const": "adversarial-historical-candidate-import.v1"},
          "import_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_issue": {"const": 9656},
          "source_identity": {"type": "object"},
          "source_files": {"type": "array", "items": {"type": "object"}},
          "candidate_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "uniqueItems": true
          },
          "candidate_count": {"type": "integer", "minimum": 0},
          "source_rows_verified": {"type": "integer", "minimum": 0},
          "candidate_status_counts": {"type": "object"},
          "source_replay_status_counts": {"type": "object"},
          "criticality_anomaly_counts": {"type": "object"},
          "failed_replay_attempts": {"type": "object"},
          "failed_setup_jobs": {"type": "integer", "minimum": 0},
          "evidence_tier": {"type": "string", "minLength": 1},
          "claim_boundary": {"type": "string", "minLength": 1},
          "artifact_paths": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "admission_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "attempt_id",
          "source_kind",
          "source_id",
          "decision",
          "blockers",
          "candidate_identity",
          "duplicate_case_id",
          "near_duplicate_report"
        ],
        "properties": {
          "schema_version": {"const": "adversarial-counterexample-admission-attempt.v1"},
          "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_kind": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["admitted", "duplicate", "rejected"]},
          "blockers": {"type": "array", "items": {"type": "string"}},
          "candidate_identity": {"type": ["string", "null"]},
          "duplicate_case_id": {"type": ["string", "null"]},
          "near_duplicate_report": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "planner_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "evaluation_id",
          "case_id",
          "effective_scenario_sha256",
          "planner_id",
          "planner_config_identity",
          "source_revision",
          "episode_sha256",
          "execution_mode",
          "readiness_status",
          "availability_status",
          "fallback_or_degraded",
          "evidence_status",
          "error",
          "outcome",
          "termination_reason",
          "metrics"
        ],
        "properties": {
          "schema_version": {"const": "adversarial-counterexample-planner-evaluation.v1"},
          "evaluation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "case_id": {"type": "string", "minLength": 1},
          "effective_scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "planner_id": {"type": "string", "minLength": 1},
          "planner_config_identity": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "episode_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "execution_mode": {"type": "string", "minLength": 1},
          "readiness_status": {"type": "string", "minLength": 1},
          "availability_status": {"type": "string", "minLength": 1},
          "fallback_or_degraded": {"type": ["boolean", "null"]},
          "evidence_status": {"enum": ["complete", "failed", "partial", "missing", "unknown"]},
          "error": {"type": ["string", "null"]},
          "outcome": {
            "type": ["object", "null"],
            "properties": {
              "collision_event": {"type": ["boolean", "null"]},
              "route_complete": {"type": ["boolean", "null"]},
              "timeout_event": {"type": ["boolean", "null"]}
            }
          },
          "termination_reason": {"type": ["string", "null"], "minLength": 1},
          "metrics": {"type": "object"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"evidence_status": {"const": "complete"}},
              "required": ["evidence_status"]
            },
            "then": {
              "properties": {
                "episode_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "fallback_or_degraded": {"type": "boolean"},
                "outcome": {
                  "type": "object",
                  "required": ["collision_event", "route_complete", "timeout_event"],
                  "properties": {
                    "collision_event": {"type": "boolean"},
                    "route_complete": {"type": "boolean"},
                    "timeout_event": {"type": "boolean"}
                  }
                },
                "termination_reason": {"type": "string", "minLength": 1}
              }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  }
}
