{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/review_bundle.v1.json",
  "title": "Robot SF Review Bundle v1",
  "description": "Index of episode/trace/geometry/media/diagnostic references for scenario review. References carry identity and integrity; execution mode and scientific admission stay separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "episodes"],
  "properties": {
    "schema_version": {"const": "review-bundle.v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["episode_id", "references"],
        "properties": {
          "episode_id": {"type": "string", "minLength": 1},
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "uri",
                "format",
                "schema",
                "sha256",
                "source_commit",
                "units",
                "coordinate_frame"
              ],
              "properties": {
                "artifact_id": {"type": "string", "minLength": 1},
                "uri": {"type": "string", "minLength": 1},
                "format": {"type": "string", "minLength": 1},
                "schema": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
                "config_identity": {"type": "string"},
                "units": {"type": "string", "minLength": 1},
                "coordinate_frame": {"type": "string", "minLength": 1}
              }
            }
          },
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"enum": ["complete", "partial", "unavailable"]},
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
