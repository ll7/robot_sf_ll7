        "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        }
      }
    },
    "geometry_upstream_binding": {
      "oneOf": [
        {"$ref": "#/$defs/geometry_fixture_binding"},
