{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.dev/schemas/parametric_curriculum_diagnostic.v1.json",
  "title": "Leakage-safe parametric curriculum diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_tier",
    "claim_boundary",
    "seed",
    "parameter_space",
    "methods",
    "simulator_executed",
    "training_executed",
    "benchmark_evidence",
    "held_out_evaluation",
    "approval_required_for_training"
  ],
  "properties": {
    "schema_version": {"const": "parametric_curriculum_diagnostic.v1"},
    "evidence_tier": {"const": "diagnostic-only"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "parameter_space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "dimensions", "digest"],
      "properties": {
        "schema_version": {"const": "parametric_curriculum.v1"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "kind", "minimum", "maximum"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "kind": {"const": "continuous"},
                  "minimum": {"type": "number"},
                  "maximum": {"type": "number"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "kind", "values"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "kind": {"const": "categorical"},
                  "values": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                }
              }
            ]
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "strategy",
          "training_manifest",
          "evaluation_manifest",
          "matched_train_count",
          "replay_verified",
          "leakage_check",
          "training_executed",
          "result_status"
        ],
        "properties": {
          "method_id": {"type": "string", "minLength": 1},
          "strategy": {"enum": ["fixed", "random", "structured"]},
          "training_manifest": {"$ref": "#/$defs/manifest"},
          "evaluation_manifest": {"$ref": "#/$defs/manifest"},
          "matched_train_count": {"type": "integer", "minimum": 1},
          "replay_verified": {"const": true},
          "leakage_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "overlapping_scenario_ids", "overlapping_parameter_hashes"],
            "properties": {
              "status": {"const": "passed"},
              "overlapping_scenario_ids": {"const": []},
              "overlapping_parameter_hashes": {"const": []}
            }
          },
          "training_executed": {"const": false},
          "result_status": {"const": "not_executed"}
        }
      }
    },
    "simulator_executed": {"const": false},
    "training_executed": {"const": false},
    "benchmark_evidence": {"const": false},
    "held_out_evaluation": {"const": true},
    "approval_required_for_training": {"const": true}
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "split", "seed", "strategy", "entries", "sha256"],
      "properties": {
        "schema_version": {"const": "parametric_curriculum.v1"},
        "split": {"enum": ["train", "evaluation"]},
        "seed": {"type": "integer", "minimum": 0},
        "strategy": {"enum": ["fixed", "random", "structured"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario_id", "parameters"],
            "properties": {
              "scenario_id": {"type": "string", "minLength": 1},
              "parameters": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": ["number", "string"]}
              }
            }
          }
        }
      }
    }
  }
}
