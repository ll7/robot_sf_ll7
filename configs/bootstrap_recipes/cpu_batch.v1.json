{
  "schema": "bootstrap_recipe.v1",
  "recipe_id": "cpu-batch-uv-v1",
  "execution_class": "cpu_batch",
  "title": "Ordinary CPU batch environment (uv sync, no GPU, no CARLA)",
  "verification_status": "verified",
  "source_identity": {"repository": "ll7/robot_sf_ll7", "lockfile": "uv.lock", "lockfile_sha256": "d01cbbf7fb7215d140b3c78f66202e0c48e449601f809036f5e02e9a9bfb79c7"},
  "prerequisites": [
    {"id": "uv", "kind": "binary", "identity": "uv>=0.11", "probe": {"argv": ["uv", "--version"], "expect_exit_code": 0}},
    {"id": "python", "kind": "binary", "identity": "python3>=3.11", "probe": {"argv": ["python3", "--version"], "expect_exit_code": 0}}
  ],
  "identity_bindings": [{"kind": "python-package", "name": "numpy", "version": "2.4.6"}],
  "steps": [
    {"id": "sync-env", "phase": "setup", "argv": ["uv", "sync", "--all-extras"], "workdir": "$PROJECT_ROOT", "env": {"UV_PROJECT_ENVIRONMENT": "$PROJECT_ROOT/.venv"}},
    {"id": "python-version", "phase": "probe", "argv": ["python3", "--version"], "workdir": "$RECIPE_ROOT", "safe_check": true},
    {"id": "uv-version", "phase": "probe", "argv": ["uv", "--version"], "workdir": "$RECIPE_ROOT", "safe_check": true},
    {"id": "import-smoke", "phase": "probe", "argv": ["uv", "run", "python", "-c", "import robot_sf"], "workdir": "$PROJECT_ROOT"},
    {"id": "drop-scratch", "phase": "cleanup", "argv": ["rm", "-rf", "$RECIPE_ROOT/scratch"], "workdir": "$RECIPE_ROOT"}
  ],
  "environment_inputs": {"PATH": "toolchain resolving uv, python3, and git"},
  "outputs": ["$PROJECT_ROOT/output/cpu_batch/"],
  "private_substitutions": [],
  "verification": {"mode": "structural+discovery-probe", "checked_at": "2026-09-12", "host_class": "linux-x86_64-cpu"}
}
