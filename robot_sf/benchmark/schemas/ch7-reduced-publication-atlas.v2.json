{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/ch7-reduced-publication-atlas.v2.json",
  "title": "Chapter 7 reduced publication atlas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metric_contract",
    "terminal_label_normalization",
    "cells",
    "roles",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "ch7-reduced-publication-atlas.v2"},
    "metric_contract": {"const": "collision_count_mean_fields_are_per_episode_counts.v1"},
    "terminal_label_normalization": {"$ref": "#/$defs/terminal_label_normalization"},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    },
    "roles": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "terminal_label_normalization": {
      "$comment": "Terminal counts are normalized labels; the raw 'terminated' reason is reported as 'timeout' (issue #7068).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "applies_to",
        "precedence",
        "source_conditions",
        "normalized_timeout_reasons",
        "raw_termination_reason_included",
        "note"
      ],
      "properties": {
        "contract": {"const": "ch7-terminal-label-normalization.v1"},
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "precedence": {
          "type": "array",
          "items": {"enum": ["route_complete", "collision_event", "timeout", "unavailable"]},
          "minItems": 4,
          "uniqueItems": true
        },
        "source_conditions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1},
          "required": ["route_complete", "collision_event", "timeout", "unavailable"]
        },
        "normalized_timeout_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "contains": {"const": "terminated"}
        },
        "raw_termination_reason_included": {"const": false},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scenario_id",
        "planner_key",
        "episodes",
        "success_fraction",
        "collision_count_mean",
        "ped_collision_count_mean",
        "obstacle_collision_count_mean",
        "total_collision_count_mean",
        "terminal_counts"
      ],
      "not": {
        "anyOf": [
          {"required": ["collision_fraction"]},
          {"required": ["ped_collision_fraction"]},
          {"required": ["obstacle_collision_fraction"]},
          {"required": ["total_collision_fraction"]}
        ]
      },
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "planner_key": {"type": "string", "minLength": 1},
        "episodes": {"type": "integer", "minimum": 1},
        "success_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "collision_count_mean": {"type": "number", "minimum": 0},
        "ped_collision_count_mean": {"type": "number", "minimum": 0},
        "obstacle_collision_count_mean": {"type": "number", "minimum": 0},
        "total_collision_count_mean": {"type": "number", "minimum": 0},
        "terminal_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
