{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/robot-sf/target_planner_replay_result.v1.json",
  "title": "Robot SF Target Planner Replay Result (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replay_kind",
    "episode_id",
    "scenario_id",
    "seed",
    "planner_id",
    "source_commit",
    "source_episodes_jsonl_sha256",
    "replay_episode_id",
    "replay_episodes_jsonl_path",
    "replay_episodes_jsonl_sha256",
    "run_status",
    "fallback_or_degraded",
    "route_complete",
    "termination_reason",
    "replay_command",
    "replay_provenance_manifest_path",
    "replay_provenance_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "target_planner_replay_result.v1"},
    "replay_kind": {"const": "target_planner"},
    "episode_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "planner_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "source_episodes_jsonl_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "replay_episode_id": {"type": "string", "minLength": 1},
    "replay_episodes_jsonl_path": {"type": "string", "minLength": 1},
    "replay_episodes_jsonl_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "run_status": {"const": "ok"},
    "fallback_or_degraded": {"const": false},
    "route_complete": {"type": "boolean"},
    "termination_reason": {
      "type": "string",
      "enum": ["success", "collision", "terminated", "truncated", "max_steps"]
    },
    "replay_command": {"type": "string", "minLength": 1},
    "replay_provenance_manifest_path": {"type": "string", "minLength": 1},
    "replay_provenance_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"route_complete": {"const": true}}},
      "then": {"properties": {"termination_reason": {"const": "success"}}}
    },
    {
      "if": {"properties": {"termination_reason": {"const": "success"}}},
      "then": {"properties": {"route_complete": {"const": true}}}
    }
  ]
}
