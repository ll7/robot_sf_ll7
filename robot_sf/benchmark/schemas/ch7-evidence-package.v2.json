{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/ch7-evidence-package.v2.json",
  "title": "Chapter 7 evidence package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "status",
    "admission_status",
    "source_integrity_gate",
    "source",
    "inputs",
    "atlas",
    "projection",
    "metrics",
    "terminal_label_normalization",
    "roles",
    "admission",
    "claim_boundary",
    "raw_traces_included",
    "release_archive_included",
    "deterministic_serialization"
  ],
  "properties": {
    "schema_version": {"const": "ch7-evidence-package.v2"},
    "issue": {"const": 7087},
    "status": {"enum": ["blocked_pending_domain_approval", "admitted"]},
    "admission_status": {"enum": ["not_admitted", "admitted"]},
    "source_integrity_gate": {"enum": ["blocked_pending_domain_approval", "passed"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1_package_sha256sums",
        "v1_manifest_sha256",
        "v1_audit_member",
        "v1_audit_member_sha256",
        "v1_reduced_atlas_member",
        "v1_reduced_atlas_member_sha256"
      ],
      "properties": {
        "v1_package_sha256sums": {"$ref": "#/$defs/sha256"},
        "v1_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "v1_audit_member": {"const": "audit/campaign_atlas.csv"},
        "v1_audit_member_sha256": {"$ref": "#/$defs/sha256"},
        "v1_reduced_atlas_member": {"const": "publication/reduced_atlas.json"},
        "v1_reduced_atlas_member_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portfolio_config"],
      "properties": {
        "portfolio_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "configs/analysis/ch7_worked_example_portfolio.v2.yaml"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_audit_cells", "publication_cells", "planner_arms"],
      "properties": {
        "source_audit_cells": {"const": 672},
        "publication_cells": {"const": 28},
        "planner_arms": {"const": 14}
      }
    },
    "projection": {"$ref": "#/$defs/projections"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {
          "const": [
            "success_fraction",
            "near_misses_mean",
            "time_to_goal_norm_mean",
            "path_efficiency_mean"
          ]
        },
        "excluded": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/excluded_metric"}}
      }
    },
    "terminal_label_normalization": {"$ref": "#/$defs/terminal_label_normalization"},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cross_topology_inversion", "cross_mechanism_inversion", "feasibility_criticism"],
      "properties": {
        "cross_topology_inversion": {"$ref": "#/$defs/available_role"},
        "cross_mechanism_inversion": {"$ref": "#/$defs/available_role"},
        "feasibility_criticism": {"$ref": "#/$defs/available_geometry_role"}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_required", "receipt_schema", "reason"],
      "properties": {
        "status": {"enum": ["not_admitted", "admitted"]},
        "receipt_required": {"const": true},
        "receipt_schema": {"const": "ch7-evidence-admission.v2"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "raw_traces_included": {"const": false},
    "release_archive_included": {"const": false},
    "deterministic_serialization": {"const": "strict-json-sort-keys-utf8-newline.v1"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked_pending_domain_approval"}}},
      "then": {
        "properties": {
          "admission_status": {"const": "not_admitted"},
          "source_integrity_gate": {"const": "blocked_pending_domain_approval"},
          "admission": {"properties": {"status": {"const": "not_admitted"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "admitted"}}},
      "then": {
        "properties": {
          "admission_status": {"const": "admitted"},
          "source_integrity_gate": {"const": "passed"},
          "admission": {"properties": {"status": {"const": "admitted"}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "available_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "grain"],
      "properties": {
        "status": {"const": "available"},
        "grain": {"const": "release_cell"}
      }
    },
    "available_geometry_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "grain"],
      "properties": {
        "status": {"const": "available"},
        "grain": {"const": "release_cell_geometry"}
      }
    },
    "excluded_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "issue", "status", "reason"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "issue": {"const": 7042},
        "status": {"const": "excluded"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios", "planners", "cell_count"],
      "properties": {
        "scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "planners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cell_count": {"type": "integer", "minimum": 1}
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cross_topology", "cross_mechanism", "narrow_doorway_terminal"],
      "properties": {
        "cross_topology": {"$ref": "#/$defs/projection"},
        "cross_mechanism": {"$ref": "#/$defs/projection"},
        "narrow_doorway_terminal": {"$ref": "#/$defs/projection"}
      }
    },
    "terminal_label_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "applies_to",
        "precedence",
        "source_conditions",
        "normalized_timeout_reasons",
        "raw_termination_reason_included",
        "note"
      ],
      "properties": {
        "contract": {"const": "ch7-terminal-label-normalization.v1"},
        "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "precedence": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["route_complete", "collision_event", "timeout", "unavailable"]}
        },
        "source_conditions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1},
          "required": ["route_complete", "collision_event", "timeout", "unavailable"]
        },
        "normalized_timeout_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "contains": {"const": "terminated"}
        },
        "raw_termination_reason_included": {"const": false},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
