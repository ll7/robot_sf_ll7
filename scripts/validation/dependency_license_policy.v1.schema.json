{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.invalid/schemas/dependency_license_policy.v1.json",
  "title": "Robot SF dependency license disposition policy",
  "type": "object",
  "required": ["schema_version", "claim_boundary", "rules", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "robot-sf.dependency-license-policy.v1"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "distribution_mode", "disposition", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "distribution_mode": {
            "enum": [
              "user_installed",
              "bundled_source",
              "built_companion",
              "not_distributed"
            ]
          },
          "disposition": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "distribution_mode",
          "status",
          "license_facts",
          "evidence_paths",
          "disposition"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "distribution_mode": {
            "enum": ["bundled_source", "built_companion", "not_distributed"]
          },
          "status": {"enum": ["pending_review", "reviewed", "excluded"]},
          "reviewer": {"type": ["string", "null"]},
          "reviewed_at": {"type": ["string", "null"]},
          "license_facts": {"type": "object"},
          "evidence_paths": {"type": "array", "items": {"type": "string"}},
          "disposition": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
