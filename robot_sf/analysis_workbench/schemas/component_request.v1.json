{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/component_request.v1.json",
  "$title": "Robot SF Component Request v1",
  "description": "Fixture request envelope for a review-contract component invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "component_id", "sources", "output_directory"],
  "properties": {
    "schema_version": {"const": "component-request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "uri", "format"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1}
        }
      }
    },
    "config": {"type": "object", "additionalProperties": true},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_directory": {"type": "string", "minLength": 1}
  }
}
