{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QualityReport",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "quality_report.v1"
    },
    "stamp": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "base_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "recorded_at_utc": {
          "type": "string"
        },
        "tree_state": {
          "type": "string",
          "enum": ["clean", "dirty"]
        }
      },
      "required": ["branch", "base_ref", "head_sha", "recorded_at_utc", "tree_state"]
    },
    "signals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "cadence": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "decision_use": {
            "type": "string"
          },
          "gate_class": {
            "type": "string",
            "enum": ["required", "diagnostic", "unavailable"]
          },
          "status": {
            "type": "string",
            "enum": ["available", "unavailable", "deferred"]
          },
          "value": {},
          "unit": {
            "type": ["string", "null"]
          },
          "source": {
            "type": ["string", "null"]
          },
          "source_gap": {
            "type": ["string", "null"]
          },
          "categories": {
            "type": ["object", "null"]
          }
        },
        "required": ["label", "gate_class", "status"]
      }
    }
  },
  "required": ["schema_version", "stamp", "signals"]
}
