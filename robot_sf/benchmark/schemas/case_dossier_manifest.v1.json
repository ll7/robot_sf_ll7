{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-sf.local/schemas/case_dossier_manifest.v1.json",
  "title": "Chapter 7 case dossier output manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dossier_id",
    "case_id",
    "mode",
    "comparison_grammar",
    "claim_template_id",
    "scientific_admission",
    "comparison",
    "selection",
    "renderer",
    "source_bindings",
    "shared_scales",
    "panel_status",
    "semantic_events",
    "claim_fields",
    "outputs",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "case_dossier_manifest.v1"},
    "dossier_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["production", "synthetic_fixture"]},
    "comparison_grammar": {
      "enum": ["matched_start_planner", "same_cell_seed_sensitivity"]
    },
    "claim_template_id": {
      "enum": [
        "matched_start_descriptive.v1",
        "same_cell_distinct_start_abstention.v1"
      ]
    },
    "scientific_admission": {"const": false},
    "comparison": {
      "type": "object",
      "required": [
        "shared_prefix",
        "recorded_start_separation",
        "divergence_interpretation",
        "prohibited_semantics"
      ],
      "additionalProperties": true
    },
    "selection": {
      "type": "object",
      "required": [
        "case_id",
        "selected",
        "selection_manifest_sha256",
        "grain",
        "primary_role",
        "allowed_claim",
        "claim_grade",
        "evidence_grade",
        "eligibility",
        "source_provenance"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/identityToken"},
        "selected": {"const": true},
        "selection_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "grain": {"$ref": "#/$defs/identityToken"},
        "primary_role": {"$ref": "#/$defs/identityToken"},
        "allowed_claim": {
          "enum": [
            "Different executed planner stacks show different observed processes and terminal outcomes under the matched recorded start.",
            "The recorded traces show distinct observed paths and terminal outcomes from different recorded starts."
          ]
        },
        "claim_grade": {"const": "descriptive"},
        "evidence_grade": {"type": "number"},
        "eligibility": {"$ref": "#/$defs/selectionEligibility"},
        "source_provenance": {"$ref": "#/$defs/sourceProvenance"}
      },
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "required": ["renderer_version", "style_version", "input_schema_version", "manifest_schema_version"],
      "additionalProperties": true
    },
    "source_bindings": {
      "type": "object",
      "required": ["portfolio", "process_traces", "campaign_atlas", "source_classes"],
      "properties": {
        "campaign_atlas": {
          "type": "object",
          "required": ["release_cells"],
          "properties": {
            "release_cells": {
              "type": "array",
              "items": {"$ref": "#/$defs/atlasCellProjection"}
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "shared_scales": {"type": "object"},
    "panel_status": {"type": "object"},
    "semantic_events": {"type": "array"},
    "claim_fields": {
      "type": "object",
      "required": ["observed_signature", "competing_explanation", "causal_status", "generalization_limit"],
      "properties": {
        "observed_signature": {"type": "string", "minLength": 1},
        "competing_explanation": {"type": "string", "minLength": 1},
        "causal_status": {"enum": ["observational_only", "causal_abstention"]},
        "generalization_limit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["svg", "pdf", "caption", "sidecar"],
      "additionalProperties": {"$ref": "#/$defs/fileRef"}
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identityToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$"
    },
    "releaseArmId": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identityToken"}
      ]
    },
    "selectionEligibility": {
      "type": "object",
      "required": [
        "eligible",
        "status",
        "execution_mode",
        "telemetry_grade",
        "typed_outcome_semantics",
        "initial_state_match",
        "outcome_match"
      ],
      "properties": {
        "eligible": {"const": true},
        "status": {"const": "admitted"},
        "execution_mode": {"enum": ["native", "adapter_disclosed"]},
        "telemetry_grade": {
          "enum": ["geometry", "kinematics", "controller", "counterfactual"]
        },
        "typed_outcome_semantics": {"type": "boolean"},
        "initial_state_match": {"enum": ["pass", "fail", "unavailable"]},
        "outcome_match": {"enum": ["pass", "fail", "unavailable"]}
      },
      "additionalProperties": false
    },
    "sourceProvenance": {
      "type": "object",
      "required": [
        "synthetic_fixture",
        "visualization_only_reexecution",
        "release_id",
        "telemetry_grade",
        "hashes",
        "release_arm_bindings"
      ],
      "properties": {
        "synthetic_fixture": {"type": "boolean"},
        "visualization_only_reexecution": {"type": "boolean"},
        "release_id": {"$ref": "#/$defs/identityToken"},
        "telemetry_grade": {
          "enum": ["geometry", "kinematics", "controller", "counterfactual"]
        },
        "hashes": {
          "type": "object",
          "required": ["release_rows", "trace_package"],
          "properties": {
            "release_rows": {"$ref": "#/$defs/hashBinding"},
            "trace_package": {"$ref": "#/$defs/hashBinding"}
          },
          "additionalProperties": false
        },
        "release_arm_bindings": {
          "type": "object",
          "required": ["left", "right"],
          "properties": {
            "left": {"$ref": "#/$defs/releaseArmId"},
            "right": {"$ref": "#/$defs/releaseArmId"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hashBinding": {
      "type": "object",
      "required": ["observed_sha256", "expected_sha256", "matches_expected"],
      "properties": {
        "observed_sha256": {"$ref": "#/$defs/sha256"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "matches_expected": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "atlasCellProjection": {
      "type": "object",
      "required": [
        "scenario_family",
        "planner",
        "release_arm_id",
        "eligible",
        "n_total",
        "outcome_counts",
        "outcome_ci"
      ],
      "properties": {
        "scenario_family": {"$ref": "#/$defs/identityToken"},
        "planner": {"$ref": "#/$defs/identityToken"},
        "release_arm_id": {"$ref": "#/$defs/releaseArmId"},
        "eligible": {"const": true},
        "n_total": {"type": "integer", "minimum": 1},
        "outcome_counts": {"$ref": "#/$defs/outcomeCounts"},
        "outcome_ci": {"$ref": "#/$defs/outcomeIntervals"}
      },
      "additionalProperties": false
    },
    "outcomeCounts": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "success": {"type": "integer", "minimum": 0},
        "collision": {"type": "integer", "minimum": 0},
        "timeout": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "outcomeIntervals": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "success": {"$ref": "#/$defs/interval3"},
        "collision": {"$ref": "#/$defs/interval3"},
        "timeout": {"$ref": "#/$defs/interval3"}
      },
      "additionalProperties": false
    },
    "interval3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "fileRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
