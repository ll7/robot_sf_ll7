            "semantic_anchor_unavailable",
            "closest_approach_diagnostic_unavailable",
            "closest_approach_values_unavailable"
          ]
        }
      },
      "additionalProperties": false
    },
    "commandedSpeedStatus": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"enum": ["commanded_speed", "commanded_speed_unavailable"]}
      },
      "additionalProperties": false
    },
    "turnRateStatus": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "commanded",
        "executed",
        "executed_unavailable_note",
        "tick_label_overlap_checked"
      ],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {
          "enum": [
            "recorded_commanded_angular_velocity",
            "commanded_angular_velocity_unavailable"
          ]
        },
        "commanded": {"$ref": "#/$defs/commandedTurnRoles"},
        "executed": {"$ref": "#/$defs/executedTurnRoles"},
        "executed_unavailable_note": {"$ref": "#/$defs/executedTurnNote"},
        "tick_label_overlap_checked": {"const": true}
      },
      "additionalProperties": false
    },
    "commandedTurnRoles": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/commandedTurnRole"},
        "right": {"$ref": "#/$defs/commandedTurnRole"}
      },
      "additionalProperties": false
    },
    "commandedTurnRole": {
      "type": "object",
      "required": ["status", "reason", "artist_count", "nonzero_observed"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {
          "enum": [
            "recorded_commanded_angular_velocity",
            "commanded_angular_velocity_unavailable"
          ]
        },
        "artist_count": {"type": "integer", "minimum": 0},
        "nonzero_observed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "executedTurnRoles": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/executedTurnRole"},
        "right": {"$ref": "#/$defs/executedTurnRole"}
      },
      "additionalProperties": false
    },
    "executedTurnRole": {
      "type": "object",
      "required": ["status", "reason", "source", "artist_count", "nonzero_observed"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {
          "enum": [
            "explicit_executed_angular_velocity",
            "explicit_executed_angular_velocity_unavailable"
          ]
        },
        "source": {
          "const": "source_trace.content_receipt.content_contract.frames[].planner.executed_action.angular_velocity"
        },
        "artist_count": {"type": "integer", "minimum": 0},
        "nonzero_observed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "executedTurnNote": {
      "type": "object",
      "required": ["status", "reason", "roles", "artist_count"],
      "properties": {
        "status": {"enum": ["available", "not_applicable"]},
        "reason": {
          "enum": [
            "explicit_executed_angular_velocity_unavailable",
            "executed_angular_velocity_available"
          ]
        },
        "roles": {
          "type": "array",
          "items": {"enum": ["left", "right"]},
          "uniqueItems": true,
          "maxItems": 2
        },
        "artist_count": {"type": "integer", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "progressStallStatus": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"enum": ["route_progress_rate", "route_progress_unavailable"]}
      },
      "additionalProperties": false
    },
    "controllerStateStatus": {
      "oneOf": [
        {"$ref": "#/$defs/controllerStateAvailable"},
        {"$ref": "#/$defs/controllerStateUnavailable"}
      ]
    },
    "controllerStateAvailable": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "signals",
        "artist_count",
        "label_artist_count",
        "semantic_event_cursor_count",
        "signal_row_count",
        "layout",
        "decoding",
        "text_bounds_checked",
        "text_overlap_checked",
        "tick_label_overlap_checked"
      ],
      "properties": {
        "status": {"const": "available"},
        "reason": {"const": "source_planner_categorical_signals"},
        "signals": {"$ref": "#/$defs/controllerSignalsProjection"},
        "artist_count": {"type": "integer", "minimum": 0},
        "label_artist_count": {"type": "integer", "minimum": 0},
        "semantic_event_cursor_count": {"type": "integer", "minimum": 0},
        "signal_row_count": {"const": 4},
        "layout": {"const": "four_signal_rows_with_left_right_sublanes.v1"},
        "decoding": {"$ref": "#/$defs/controllerDecodingAvailable"},
        "text_bounds_checked": {"const": true},
        "text_overlap_checked": {"const": true},
        "tick_label_overlap_checked": {"const": true}
      },
      "additionalProperties": false
    },
    "controllerStateUnavailable": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "signals",
        "artist_count",
        "signal_row_count",
        "layout",
        "decoding",
        "text_bounds_checked",
        "text_overlap_checked",
        "tick_label_overlap_checked"
      ],
      "properties": {
        "status": {"const": "unavailable"},
        "reason": {"const": "controller_state_signal_absent"},
        "signals": {"$ref": "#/$defs/controllerSignalsProjection"},
        "artist_count": {"const": 0},
        "signal_row_count": {"const": 4},
        "layout": {"const": "unavailable_summary.v1"},
        "decoding": {"$ref": "#/$defs/controllerDecodingUnavailable"},
        "text_bounds_checked": {"const": true},
        "text_overlap_checked": {"const": true},
        "tick_label_overlap_checked": {"const": true}
      },
      "additionalProperties": false
    },
    "controllerSignalsProjection": {
      "type": "object",
      "required": ["controller_state", "command_source", "guard_state", "fallback_state"],
      "properties": {
        "controller_state": {"$ref": "#/$defs/controllerStateSignalProjection"},
        "command_source": {"$ref": "#/$defs/commandSourceSignalProjection"},
        "guard_state": {"$ref": "#/$defs/guardStateSignalProjection"},
        "fallback_state": {"$ref": "#/$defs/fallbackStateSignalProjection"}
      },
      "additionalProperties": false
    },
    "controllerStateSignalProjection": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalProjection"},
        {
          "type": "object",
          "properties": {
            "roles": {"$ref": "#/$defs/controllerStateSignalRoles"},
            "value_styles": {"$ref": "#/$defs/controllerStateValueStyles"}
          }
        }
      ]
    },
    "commandSourceSignalProjection": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalProjection"},
        {
          "type": "object",
          "properties": {
            "roles": {"$ref": "#/$defs/commandSourceSignalRoles"},
            "value_styles": {"$ref": "#/$defs/commandSourceValueStyles"}
          }
        }
      ]
    },
    "guardStateSignalProjection": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalProjection"},
        {
          "type": "object",
          "properties": {
            "roles": {"$ref": "#/$defs/guardStateSignalRoles"},
            "value_styles": {"$ref": "#/$defs/guardStateValueStyles"}
          }
        }
      ]
    },
    "fallbackStateSignalProjection": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalProjection"},
        {
          "type": "object",
          "properties": {
            "roles": {"$ref": "#/$defs/fallbackStateSignalRoles"},
            "value_styles": {"$ref": "#/$defs/fallbackStateValueStyles"}
          }
        }
      ]
    },
    "controllerSignalProjection": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "source",
        "roles",
        "artist_count",
        "label_artist_count",
        "row_index",
        "value_styles"
      ],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {
          "enum": ["source_planner_categorical_signal", "source_planner_signal_absent"]
        },
        "source": {"type": "string", "minLength": 1},
        "roles": {"$ref": "#/$defs/controllerSignalRoles"},
        "artist_count": {"type": "integer", "minimum": 0},
        "label_artist_count": {"type": "integer", "minimum": 0},
        "row_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "value_styles": {"$ref": "#/$defs/controllerValueStyles"}
      },
      "additionalProperties": false
    },
    "controllerSignalRoles": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/controllerSignalRole"},
        "right": {"$ref": "#/$defs/controllerSignalRole"}
      },
      "additionalProperties": false
    },
    "controllerSignalRole": {
      "type": "object",
      "required": ["status", "values", "artist_count", "sublane"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/controllerCategoricalValue"},
          "uniqueItems": true
        },
        "artist_count": {"type": "integer", "minimum": 0},
        "label_artist_count": {"type": "integer", "minimum": 0},
        "sublane": {"enum": ["left", "right"]}
      },
      "additionalProperties": false
    },
    "controllerStateSignalRoles": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/controllerStateSignalRole"},
        "right": {"$ref": "#/$defs/controllerStateSignalRole"}
      },
      "additionalProperties": false
    },
    "controllerStateSignalRole": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalRole"},
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {"$ref": "#/$defs/controllerStateValue"}
            }
          }
        }
      ]
    },
    "commandSourceSignalRoles": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/commandSourceSignalRole"},
        "right": {"$ref": "#/$defs/commandSourceSignalRole"}
      },
      "additionalProperties": false
    },
    "commandSourceSignalRole": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalRole"},
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {"$ref": "#/$defs/commandSourceValue"}
            }
          }
        }
      ]
    },
    "guardStateSignalRoles": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/guardStateSignalRole"},
        "right": {"$ref": "#/$defs/guardStateSignalRole"}
      },
      "additionalProperties": false
    },
    "guardStateSignalRole": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalRole"},
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {"$ref": "#/$defs/guardStateValue"}
            }
          }
        }
      ]
    },
    "fallbackStateSignalRoles": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/fallbackStateSignalRole"},
        "right": {"$ref": "#/$defs/fallbackStateSignalRole"}
      },
      "additionalProperties": false
    },
    "fallbackStateSignalRole": {
      "allOf": [
        {"$ref": "#/$defs/controllerSignalRole"},
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {"$ref": "#/$defs/fallbackStateValue"}
            }
          }
        }
      ]
    },
    "controllerValueStyles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/controllerCategoricalValue"},
      "additionalProperties": {"$ref": "#/$defs/controllerValueStyle"}
    },
    "controllerStateValueStyles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/controllerStateValue"},
      "additionalProperties": {"$ref": "#/$defs/controllerValueStyle"}
    },
    "commandSourceValueStyles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/commandSourceValue"},
      "additionalProperties": {"$ref": "#/$defs/controllerValueStyle"}
    },
    "guardStateValueStyles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/guardStateValue"},
      "additionalProperties": {"$ref": "#/$defs/controllerValueStyle"}
    },
    "fallbackStateValueStyles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/fallbackStateValue"},
      "additionalProperties": {"$ref": "#/$defs/controllerValueStyle"}
    },
    "controllerCategoricalValue": {
      "enum": ["tracking", "braking", "planner", "clear", "active", "inactive"]
    },
    "controllerStateValue": {"enum": ["tracking", "braking"]},
    "commandSourceValue": {"const": "planner"},
    "guardStateValue": {"enum": ["clear", "active"]},
    "fallbackStateValue": {"const": "inactive"},
    "controllerValueStyle": {
      "type": "object",
      "required": ["color", "label_rendered"],
      "properties": {
        "color": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
        "label_rendered": {"const": true}
      },
      "additionalProperties": false
    },
    "controllerDecodingAvailable": {
      "type": "object",
      "required": ["method", "role_encoding", "all_values_labelled"],
      "properties": {
        "method": {"const": "direct_segment_labels"},
        "role_encoding": {"const": "labelled_left_right_sublanes"},
        "all_values_labelled": {"const": true}
      },
      "additionalProperties": false
    },
    "controllerDecodingUnavailable": {
      "type": "object",
      "required": ["method", "role_encoding", "all_values_labelled"],
      "properties": {
        "method": {"const": "explicit_unavailable_text"},
        "role_encoding": {"const": "not_applicable"},
        "all_values_labelled": {"const": true}
      },
      "additionalProperties": false
    },
    "semanticStyleKeyStatus": {
      "type": "object",
      "required": ["status", "reason", "labels", "artist_count"],
      "properties": {
        "status": {"const": "available"},
        "reason": {"const": "complete_semantic_style_key"},
        "labels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true
        },
        "artist_count": {"const": 12}
      },
      "additionalProperties": false
    },
    "cellContextStatus": {
      "type": "object",
      "required": ["status", "reason", "uncertainty"],
      "properties": {
        "status": {"const": "available"},
        "reason": {"const": "campaign_atlas_cell"},
        "uncertainty": {"$ref": "#/$defs/uncertaintyProjection"}
      },
      "additionalProperties": false
    },
    "ensembleContextStatus": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {
          "enum": [
            "synthetic_fixture_no_ensemble_inventory",
            "production_ensemble_inventory_unavailable",
            "ensemble_inventory_complete"
          ]
        }
      },
      "additionalProperties": false
    },
    "identityToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$"
    },
    "releaseArmId": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identityToken"}
      ]
    },
    "selectionEligibility": {
      "type": "object",
      "required": [
        "eligible",
        "status",
        "execution_mode",
        "telemetry_grade",
        "typed_outcome_semantics",
        "initial_state_match",
        "outcome_match"
      ],
      "properties": {
        "eligible": {"const": true},
        "status": {"const": "admitted"},
        "execution_mode": {"enum": ["native", "adapter_disclosed"]},
        "telemetry_grade": {
          "enum": ["geometry", "kinematics", "controller", "counterfactual"]
        },
        "typed_outcome_semantics": {"type": "boolean"},
        "initial_state_match": {"enum": ["pass", "fail", "unavailable"]},
        "outcome_match": {"enum": ["pass", "fail", "unavailable"]}
      },
      "additionalProperties": false
    },
    "sourceProvenance": {
      "type": "object",
      "required": [
        "synthetic_fixture",
        "visualization_only_reexecution",
        "release_id",
        "telemetry_grade",
        "hashes",
        "release_arm_bindings"
      ],
      "properties": {
        "synthetic_fixture": {"type": "boolean"},
        "visualization_only_reexecution": {"type": "boolean"},
        "release_id": {"$ref": "#/$defs/identityToken"},
        "telemetry_grade": {
          "enum": ["geometry", "kinematics", "controller", "counterfactual"]
        },
        "hashes": {
          "type": "object",
          "required": ["release_rows", "trace_package"],
          "properties": {
            "release_rows": {"$ref": "#/$defs/hashBinding"},
            "trace_package": {"$ref": "#/$defs/hashBinding"}
          },
          "additionalProperties": false
        },
        "release_arm_bindings": {
          "type": "object",
          "required": ["left", "right"],
          "properties": {
            "left": {"$ref": "#/$defs/releaseArmId"},
            "right": {"$ref": "#/$defs/releaseArmId"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hashBinding": {
      "type": "object",
      "required": ["observed_sha256", "expected_sha256", "matches_expected"],
      "properties": {
        "observed_sha256": {"$ref": "#/$defs/sha256"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "matches_expected": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "atlasCellProjection": {
      "type": "object",
      "required": [
        "scenario_family",
        "planner",
        "release_arm_id",
        "eligible",
        "n_total",
        "outcome_counts",
        "outcome_ci"
      ],
      "properties": {
        "scenario_family": {"$ref": "#/$defs/identityToken"},
        "planner": {"$ref": "#/$defs/identityToken"},
        "release_arm_id": {"$ref": "#/$defs/releaseArmId"},
        "eligible": {"const": true},
        "n_total": {"type": "integer", "minimum": 1},
        "outcome_counts": {"$ref": "#/$defs/outcomeCounts"},
        "outcome_ci": {"$ref": "#/$defs/outcomeIntervals"}
      },
      "additionalProperties": false
    },
    "outcomeCounts": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "success": {"type": "integer", "minimum": 0},
        "collision": {"type": "integer", "minimum": 0},
        "timeout": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "outcomeIntervals": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "success": {"$ref": "#/$defs/interval3"},
        "collision": {"$ref": "#/$defs/interval3"},
        "timeout": {"$ref": "#/$defs/interval3"}
      },
      "additionalProperties": false
    },
    "interval2": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "range2": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "range4": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "interval3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "fileRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
