{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/robot-sf/scenario_admissibility.v1.json",
  "title": "Robot SF Scenario Admissibility Verdict (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "scenario_id",
    "verdict",
    "target_planner_outcome",
    "search_disposition",
    "reason_codes",
    "assumptions",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "scenario_admissibility.v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "structurally_invalid",
        "geometric_or_kinodynamic_impossibility",
        "admissible_feasibility_unknown",
        "empirically_feasible",
        "planner_specific_failure"
      ]
    },
    "target_planner_outcome": {
      "type": "string",
      "enum": [
        "not_evaluated",
        "unavailable",
        "route_completed",
        "route_incomplete"
      ]
    },
    "search_disposition": {
      "type": "string",
      "enum": [
        "retain",
        "reject"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "structurally_invalid",
              "geometric_or_kinodynamic_impossibility"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "search_disposition": {
            "const": "reject"
          }
        }
      },
      "else": {
        "properties": {
          "search_disposition": {
            "const": "retain"
          }
        }
      }
    }
  ]
}
