{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ll7/robot_sf_ll7/blob/main/tools/flint-chart/surface-input-schema.v1.json",
  "title": "Flint analysis-only surface input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface_id",
    "figure_id",
    "metric",
    "source",
    "display_population",
    "canonical_cells",
    "candidate_cells",
    "renderer_policy"
  ],
  "properties": {
    "schema_version": {"const": "flint-chart-surface-input.v1"},
    "surface_id": {"type": "string", "minLength": 1},
    "figure_id": {"type": "string", "minLength": 1},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "source": {"$ref": "#/$defs/source"},
    "display_population": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/populationItem"}
    },
    "canonical_cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    },
    "candidate_cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    },
    "renderer_policy": {"$ref": "#/$defs/rendererPolicy"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "source_commit",
        "release_id",
        "artifact_catalog",
        "input_hashes",
        "durability"
      ],
      "properties": {
        "context": {"enum": ["release", "replay"]},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_id": {"type": "string", "minLength": 1},
        "artifact_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "input_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "durability": {"const": "durable_pinned"}
      }
    },
    "populationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner_key", "scenario_family"],
      "properties": {
        "planner_key": {"type": "string", "minLength": 1},
        "scenario_family": {"type": "string", "minLength": 1}
      }
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "lower", "upper", "method"],
          "properties": {
            "status": {"const": "available"},
            "lower": {"type": "number"},
            "upper": {"type": "number"},
            "method": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unavailable"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_key",
        "scenario_family",
        "value",
        "denominator",
        "exposure_definition",
        "exclusions",
        "uncertainty",
        "capability_track",
        "evidence_status"
      ],
      "properties": {
        "planner_key": {"type": "string", "minLength": 1},
        "scenario_family": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "denominator": {"type": "integer", "minimum": 0},
        "exposure_definition": {"type": "string", "minLength": 1},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "capability_track": {"type": "string", "minLength": 1},
        "evidence_status": {"type": "string", "minLength": 1}
      }
    },
    "rendererPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_renderer",
        "tie_policy",
        "source_context_separation"
      ],
      "properties": {
        "canonical_renderer": {"const": "matplotlib/pgf/tikz"},
        "tie_policy": {"const": "exact_ties_no_catalog_rank"},
        "source_context_separation": {"const": true},
        "requires_uncertainty": {"type": "boolean"},
        "requires_direct_labels": {"type": "boolean"},
        "requires_tie_preservation": {"type": "boolean"}
      }
    }
  }
}
