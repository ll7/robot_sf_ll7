    "geometry_registry_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "registry_id",
        "artifact_ref",
        "content_sha256",
        "entry_id",
        "entry_sha256",
        "coordinate_frame",
        "geometry_kind",
        "resolved_geometry",
        "upstream_binding",
        "owner_validation"
      ],
      "properties": {
        "schema_version": {"const": "process_trace_geometry_registry.v1"},
        "registry_id": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entry_id": {"type": "string", "minLength": 1},
        "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coordinate_frame": {"const": "world"},
        "geometry_kind": {"enum": ["line_segment", "polyline", "circle"]},
        "resolved_geometry": {"type": "object"},
        "upstream_binding": {"$ref": "#/$defs/geometry_upstream_binding"},
        "owner_validation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": {"const": "fixture_only"},
                "reason": {"const": "fixture_binding_not_canonical_owner"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_artifact_ref",
                "source_content_sha256",
                "selector",
                "geometry_sha256"
              ],
              "properties": {
                "status": {"const": "verified"},
                "source_artifact_ref": {"type": "string", "minLength": 1},
                "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "selector": {"type": "object", "minProperties": 1},
                "geometry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        }
      }
    },
